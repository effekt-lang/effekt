import io/time
import exception

extern llvm """
  declare i32 @pthread_create(ptr noundef, ptr noundef, ptr noundef, ptr noundef)
  declare i32 @pthread_join(i64 noundef, ptr noundef)

  declare i32 @pthread_mutex_init(ptr noundef, ptr)
  declare i32 @pthread_mutex_lock(ptr noundef)
  declare i32 @pthread_mutex_unlock(ptr noundef)
  declare i32 @pthread_mutex_destroy(ptr noundef)

  declare i32 @pthread_cond_init(ptr noundef, ptr)
  declare i32 @pthread_cond_signal(ptr noundef)
  declare i32 @pthread_cond_broadcast(ptr noundef)
  declare i32 @pthread_cond_wait(ptr noundef, ptr noundef)
  declare i32 @pthread_cond_destroy(ptr noundef)

  declare void @sleep(i64)

  ; Id, Function pointer, closure, stack
  %ThreadObject = type {i64, ptr, %Object, %Stack}

  %Inbox = type i64

  ; front, rear, data ptr, mutex, cond, cond mutex
  %MessageQueue = type {i64, i64, ptr, ptr, ptr, ptr}

  ; Expect a pointer to a %ThreadObject
  define void @call_thread_wrapper(ptr %threadObject) {
    %threadObj = load %ThreadObject, ptr %threadObject
    %functionPointer = extractvalue %ThreadObject %threadObj, 1
    %closure = extractvalue %ThreadObject %threadObj, 2
    %stack = extractvalue %ThreadObject %threadObj, 3

    tail call tailcc %Pos %functionPointer(%Object %closure, %Stack %stack)
    ret void 
  }

  define i64 @thread_object_size() alwaysinline {
    %to_sizeptr = getelementptr %ThreadObject, ptr null, i64 1
    %to_size = ptrtoint ptr %to_sizeptr to i64
    ret i64 %to_size
  }

  define i64 @default_queue_size() alwaysinline {
    %to_sizeptr = getelementptr %MessageQueue, ptr null, i64 1
    %to_size = ptrtoint ptr %to_sizeptr to i64
    ret i64 %to_size
  }

  define i64 @default_queue_elements() alwaysinline {
    ret i64 16
  }

  ; sizeof(pthread_mutex_t)
  define i64 @pthread_mutex_size() alwaysinline {
    ret i64 40
  }

  ; sizeof(pthread_cond_t)
  define i64 @pthread_cond_size() alwaysinline {
    ret i64 48
  }
"""

extern type ThreadObject
extern type Inbox

extern def start_thread { g: () => Unit }: ThreadObject = llvm """
  %threadObjectSize = call i64 @thread_object_size()
  %threadObject = call ptr @malloc(i64 %threadObjectSize)
  %threadIdPtr = getelementptr i64, ptr %threadObject, i64 0
  %functionPtr = getelementptr ptr, ptr %threadObject, i64 1
  %objectPtr = getelementptr %Object, ptr %threadObject, i64 2 
  %stackPtr = getelementptr %Stack, ptr %threadObject, i64 3

  %stack = call %Stack @withEmptyStack()
  store %Stack %stack, %Stack %stackPtr

  ; (f: () => Unit at {io})
  ; %neg = call %Neg @coercePosNeg(%Pos {f})
  %arrayPointer = extractvalue %Neg ${g}, 0
  %object = extractvalue %Neg ${g}, 1
  %functionPointerPointer = getelementptr ptr, ptr %arrayPointer, i64 0
  %functionPointer = load ptr, ptr %functionPointerPointer

  store %Object %object, ptr %objectPtr
  store ptr %functionPointer, ptr %functionPtr
  
  call ccc i64 @pthread_create(ptr %threadIdPtr, ptr null, ptr @call_thread_wrapper, ptr %threadObject)
  %threadPtrInt = ptrtoint ptr %threadObject to i64
  %threadPos = call %Pos @coerceIntPos(i64 %threadPtrInt)
  tail call void @sharePositive(%Pos %threadPos)
  ret %Pos %threadPos
"""

extern def thread_id(thread: ThreadObject): Int = llvm """
  %threadInt = call %Int @coercePosInt(%Pos ${thread})
  %threadPtr = inttoptr %Int %threadInt to ptr 
  %thread_id_ptr = getelementptr %ThreadObject, ptr %threadPtr, i64 0
  %thread_id = load i64, ptr %thread_id_ptr
  ret i64 %thread_id
"""

extern def join_thread(thread: ThreadObject): Unit = llvm """
  %threadInt = call %Int @coercePosInt(%Pos ${thread})
  %threadPtr = inttoptr %Int %threadInt to ptr 
  %thread_id_ptr = getelementptr %ThreadObject, ptr %threadPtr, i64 0
  %thread_id = load i64, ptr %thread_id_ptr
  call ccc i64 @pthread_join(i64 %thread_id, ptr null)
  call void @free(ptr %threadPtr)
  ret %Pos zeroinitializer
"""

extern def sleep(seconds: Int): Unit = llvm """
  call ccc void @sleep(%Int ${seconds})
  ret %Pos zeroinitializer
"""

extern type MessageQueue[R]

extern def allocateQueue[R](): MessageQueue[R] = llvm """
  %queueSize = call i64 @default_queue_size() ; size of %MessageQueue struct
  %queueDataElements = call i64 @default_queue_elements()
  %queueDataSize = mul i64 %queueDataElements, 16 ; 16 being size of %Pos

  %queue = call ptr @malloc(i64 %queueSize)
  %queueData = call ptr @malloc(i64 %queueDataSize)

  %mutexSize = call i64 @pthread_mutex_size()
  %queueMutex = call ptr @malloc(i64 %mutexSize)

  %condSize = call i64 @pthread_cond_size()
  %queueCond = call ptr @malloc(i64 %condSize)

  %queueCondMutex = call ptr @malloc(i64 %mutexSize)

  call i32 @pthread_mutex_init(ptr %queueMutex, ptr null) ; null meaning default attributes
  call i32 @pthread_mutex_init(ptr %queueCondMutex, ptr null) ; null meaning default attributes
  call i32 @pthread_cond_init(ptr %queueCond, ptr null) ; null meaning default attributes

  ; front = 0  |  rear = 0
  %queue1 = insertvalue %MessageQueue zeroinitializer, i64 0, 0       ; front
  %queue2 = insertvalue %MessageQueue %queue1, i64 0, 1               ; rear
  %queue3 = insertvalue %MessageQueue %queue2, ptr %queueData, 2      ; dataPtr
  %queue4 = insertvalue %MessageQueue %queue3, ptr %queueMutex, 3     ; mutex
  %queue5 = insertvalue %MessageQueue %queue4, ptr %queueCond, 4      ; cond
  %queue6 = insertvalue %MessageQueue %queue5, ptr %queueCondMutex, 5 ; cond mutex
  store %MessageQueue %queue6, ptr %queue, align 8 

  %pos = call %Pos @coercePtrPos(ptr %queue)

  tail call void @sharePositive(%Pos %pos)

  ret %Pos %pos
"""

extern def freeQueue[R](queue: MessageQueue[R]): Unit = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})

  %queue = load %MessageQueue, ptr %queuePtr
  %queueDataPtr = extractvalue %MessageQueue %queue, 2
  %queueMutex = extractvalue %MessageQueue %queue, 3
  %queueCond = extractvalue %MessageQueue %queue, 4
  %queueCondMutex = extractvalue %MessageQueue %queue, 5

  call i32 @pthread_mutex_destroy(ptr %queueMutex)
  call i32 @pthread_mutex_destroy(ptr %queueCondMutex)
  call i32 @pthread_cond_destroy(ptr %queueCond)

  call void @free(ptr %queueDataPtr)
  call void @free(ptr %queueMutex)
  call void @free(ptr %queueCond)
  call void @free(ptr %queueCondMutex)
  call void @free(ptr %queuePtr)
  ret %Pos zeroinitializer
"""

extern def isEmpty[R](queue: MessageQueue[R]): Bool = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})

  %mutexPtr = getelementptr ptr, ptr %queuePtr, i64 3
  %queueMutex = load atomic ptr, ptr %mutexPtr monotonic, align 8
  call i32 @pthread_mutex_lock(ptr %queueMutex)

  %frontPtr = getelementptr i64, ptr %queuePtr, i64 0
  %rearPtr = getelementptr i64, ptr %queuePtr, i64 1
  %front = load atomic i64, ptr %frontPtr acquire, align 8
  %rear = load atomic i64, ptr %rearPtr acquire, align 8

  call i32 @pthread_mutex_unlock(ptr %queueMutex)
  
  %z = icmp eq %Int %front, %rear
  %fat_z = zext i1 %z to i64
  %adt_boolean = insertvalue %Pos zeroinitializer, i64 %fat_z, 0
  ret %Pos %adt_boolean
"""

extern def isFull[R](queue: MessageQueue[R]): Bool = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})

  %mutexPtr = getelementptr ptr, ptr %queuePtr, i64 3
  %queueMutex = load atomic ptr, ptr %mutexPtr monotonic, align 8
  call i32 @pthread_mutex_lock(ptr %queueMutex)
  
  %frontPtr = getelementptr i64, ptr %queuePtr, i64 0
  %rearPtr = getelementptr i64, ptr %queuePtr, i64 1
  %front = load atomic i64, ptr %frontPtr acquire, align 8
  %rear = load atomic i64, ptr %rearPtr acquire, align 8

  call i32 @pthread_mutex_unlock(ptr %queueMutex)
  
  %rearInc = add i64 %rear, 1
  %queue_size = call i64 @default_queue_size()
  %rear_mod = srem i64 %rearInc, %queue_size

  %z = icmp eq %Int %rear_mod, %front
  %fat_z = zext i1 %z to i64
  %adt_boolean = insertvalue %Pos zeroinitializer, i64 %fat_z, 0
  ret %Pos %adt_boolean
"""

extern def unsafeEnqueue[R](queue: MessageQueue[R], value: R): Unit = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})
  %mutexPtr = getelementptr ptr, ptr %queuePtr, i64 3
  %queueMutex = load atomic ptr, ptr %mutexPtr monotonic, align 8
  call i32 @pthread_mutex_lock(ptr %queueMutex)
  
  %rearPtr = getelementptr i64, ptr %queuePtr, i64 1
  %rear = load atomic i64, ptr %rearPtr acquire, align 8

  %dataPtr = getelementptr ptr, ptr %queuePtr, i64 2
  %data = load atomic ptr, ptr %dataPtr acquire, align 8
  %valuePtr = getelementptr %Pos, ptr %data, i64 %rear

  store %Pos ${value}, ptr %valuePtr

  %rearInc = add i64 %rear, 1
  %queueSize = call i64 @default_queue_elements()
  %rearInc_mod = srem i64 %rearInc, %queueSize

  store atomic i64 %rearInc_mod, ptr %rearPtr release, align 8

  call i32 @pthread_mutex_unlock(ptr %queueMutex)

  ret %Pos zeroinitializer
"""

extern def unsafeDequeue[R](queue: MessageQueue[R]): Unit = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})

  %mutexPtr = getelementptr ptr, ptr %queuePtr, i64 3
  %queueMutex = load atomic ptr, ptr %mutexPtr monotonic, align 8
  call i32 @pthread_mutex_lock(ptr %queueMutex)
  
  %frontPtr = getelementptr i64, ptr %queuePtr, i64 0
  %front = load atomic i64, ptr %frontPtr acquire, align 8
  %frontInc = add i64 %front, 1
  %queueSize = call i64 @default_queue_elements()
  %frontInc_mod = srem i64 %frontInc, %queueSize

  store atomic i64 %frontInc_mod, ptr %frontPtr release, align 8

  call i32 @pthread_mutex_unlock(ptr %queueMutex)

  ret %Pos zeroinitializer
"""

extern def unsafePeek[R](queue: MessageQueue[R]): R = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})

  %mutexPtr = getelementptr ptr, ptr %queuePtr, i64 3
  %queueMutex = load atomic ptr, ptr %mutexPtr monotonic, align 8
  call i32 @pthread_mutex_lock(ptr %queueMutex)

  %frontPtr = getelementptr i64, ptr %queuePtr, i64 0
  %front = load atomic i64, ptr %frontPtr acquire, align 8

  %dataPtr = getelementptr ptr, ptr %queuePtr, i64 2
  %data = load atomic ptr, ptr %dataPtr acquire, align 8
  %valuePtr = getelementptr inbounds %Pos, ptr %data, i64 %front

  ; not techically atomic, because 'load %Pos' cannot directly be atomic and would need to be split. Thread safe because of mutex lock 
  %value = load %Pos, ptr %valuePtr, align 8 

  call i32 @pthread_mutex_unlock(ptr %queueMutex)

  ret %Pos %value
"""

extern def condWait[R](queue: MessageQueue[R]): Unit = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})
  
  %condPtr = getelementptr ptr, ptr %queuePtr, i64 4
  %condMutexPtr = getelementptr ptr, ptr %queuePtr, i64 5
  %cond = load atomic ptr, ptr %condPtr monotonic, align 8
  %mutex = load atomic ptr, ptr %condMutexPtr monotonic, align 8

  call i32 @pthread_mutex_lock(ptr %mutex)
  call i32 @pthread_cond_wait(ptr %cond, ptr %mutex)
  call i32 @pthread_mutex_unlock(ptr %mutex)
  
  ret %Pos zeroinitializer
"""

extern def condSignal[R](queue: MessageQueue[R]): Unit = llvm """
  %queuePtr = call ptr @coercePosPtr(%Pos ${queue})
  
  %condPtr = getelementptr ptr, ptr %queuePtr, i64 4
  %condMutexPtr = getelementptr ptr, ptr %queuePtr, i64 5
  %cond = load atomic ptr, ptr %condPtr monotonic, align 8
  %mutex = load atomic ptr, ptr %condMutexPtr monotonic, align 8

  call i32 @pthread_mutex_lock(ptr %mutex)
  call i32 @pthread_cond_signal(ptr %cond)
  call i32 @pthread_mutex_unlock(ptr %mutex)

  ret %Pos zeroinitializer
"""

def enqueue[R](queue: MessageQueue[R], value: R) at {io, async}: Bool = {
  if (queue.isFull()) {
    println("Enqueue failed, queue full")
    false
  } else {
    queue.unsafeEnqueue(value)
    true
  }
}

def dequeue[R](queue: MessageQueue[R]): Bool = {
  if (queue.isEmpty()) {
    println("Dequeue failed, queue empty")
    false
  } else {
    queue.unsafeDequeue()
    true
  }
}

def peek[R](queue: MessageQueue[R]): Option[R] = {
  if (queue.isEmpty()) {
    None()
  } else {
    Some(queue.unsafePeek())
  }
} 

