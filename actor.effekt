type ResumeValue = (Unit)
type EmitterContinuation = ResumeValue => Unit at {io, async}
type EmitterMessage {
  Resume(rv: ResumeValue, k: EmitterContinuation)
  Terminate()
}

type HandlerMessageType {
  Register()
  Deregister()
  Emit(v: Int, k: EmitterContinuation)
}

type HandlerMessage = (HandlerMessageType, MessageQueue[EmitterMessage])

def registerEmitter(handler: MessageQueue[HandlerMessage], ?emitterQueue: MessageQueue[EmitterMessage]): Unit = {
  if (not (handler.enqueue((Register(), emitterQueue)))) {
    println("Queue is full, cannot register emitter")
  }
  ()
}

def deregisterEmitter(handler: MessageQueue[HandlerMessage], ?emitterQueue: MessageQueue[EmitterMessage]): Unit = {
  if (not (handler.enqueue((Deregister(), emitterQueue)))) {
    println("Queue is full, cannot deregister emitter")
  }
  ()
}

def resumeEmitter(emitterQueue: MessageQueue[EmitterMessage], rv: ResumeValue, k: EmitterContinuation): Unit = {
  if (not (emitterQueue.enqueue(Resume(rv, k)))) {
    println("Queue is full, cannot resume emitter")
  } // else {
    // emitterQueue.condSignal()
  // }
  ()
}

def terminateEmitter(emitterQueue: MessageQueue[EmitterMessage]): Unit = {
  if (not (emitterQueue.enqueue(Terminate()))) {
    println("Queue is full, cannot terminate emitter")
  } // else {
    // emitterQueue.condSignal()
  // }
}

def startEmitter(handler: MessageQueue[HandlerMessage]): MessageQueue[EmitterMessage] = {
  val emitterQueue = allocateQueue()
  registerEmitter(handler)
  emitterQueue
}

def runEmitter(emitterQueue: MessageQueue[EmitterMessage], handler: MessageQueue[HandlerMessage]) { prog: (MessageQueue[EmitterMessage]) => Unit }: ThreadObject = {
  start_thread {
    prog(emitterQueue)

    // Handle all remaining "resumes" before ending
    if (not (emitterQueue.isEmpty)) {
      loop {
        emitterQueue.peek() match {
          case Some(msg) => {
            emitterQueue.dequeue()
            msg match {
              case Resume(rv, k) => {
                k(rv)
              }
              case Terminate() => {
                do stop()
              }
            }
          }
          case None() => do stop()
        }
      }
    }

    deregisterEmitter(handler)
  }
}

extern def ado(v: Int, ?handlerQueue: MessageQueue[HandlerMessage], ?emitterQueue: MessageQueue[EmitterMessage]) 
  { f: (Int, MessageQueue[HandlerMessage], MessageQueue[EmitterMessage], EmitterContinuation) => Unit } at async: Unit = llvm """

  %arrayPointer = extractvalue %Neg ${f}, 0
  %object = extractvalue %Neg ${f}, 1
  %functionPointerPointer = getelementptr ptr, ptr %arrayPointer, i64 0
  %functionPointer = load ptr, ptr %functionPointerPointer

  call %Pos %functionPointer(%Int ${v}, %Pos ${handlerQueue}, %Pos ${emitterQueue}, %Stack %stack)

  ret %Pos zeroinitializer
"""

def doEmit(v: Int, k: EmitterContinuation, ?handlerQueue: MessageQueue[HandlerMessage], ?emitterQueue: MessageQueue[EmitterMessage]): Unit = {
  if (not (handlerQueue.enqueue((Emit(v, k), emitterQueue)))) {
    println("Could not enqueue emit, handler is full")
  }

  // emitterQueue.condWait()
  loop {
    emitterQueue.peek() match {
      case None() => {
        // panic("Queue should only be signaled when message was enqueue after condWait")
        ()
      }
      case Some(msg) => {
        emitterQueue.dequeue()
        msg match {
          case Resume(rv, k) => k(rv)
          case Terminate() => ()
        }
        do stop()
      }
    }
  }
}

def runHandler(handlerQueue: MessageQueue[HandlerMessage]) { handle: (Int, EmitterContinuation) => Unit }: Unit = {
  var emitters = 0
  var registeredOnce = false

  loop {
    if (registeredOnce && emitters == 0) {
      // println("No more emitters. Terminating")
      // println("Handler unecessary loops " ++ unLoop.show)
      do stop()
    }
      
    handlerQueue.peek() match {
      case Some((msg, queue)) => {
        handlerQueue.dequeue()
        msg match {
          case Register() => {
            registeredOnce = true
            emitters = emitters + 1
          }
          case Deregister() => {
            emitters = emitters - 1
          }
          case Emit(v, k) => {
            handle(v, box { (rv: ResumeValue) => resumeEmitter(queue, rv, k) })
          }
        }
      }
      case None() => {
        ()
      }
    }
  }
}

def rangeEmit(lower: Int, upper: Int, ?handlerQueue: MessageQueue[HandlerMessage], ?emitterQueue: MessageQueue[EmitterMessage]): Unit = {
  if (lower < upper) {
    doEmit(lower, box { (Unit) => rangeEmit(lower + 1, upper)})
  }
  ()
}

