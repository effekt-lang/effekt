import examples/benchmarks/runner

def cps_tak(x: Int, y: Int, z: Int) { k: Int => Int }: Int =
  if (x <= y)
    k(z)
  else
    cps_tak(x - 1, y, z) { v1 =>
      cps_tak(y - 1, z, x) { v2 =>
        cps_tak(z - 1, x, y) { v3 =>
          cps_tak(v1, v2, v3) {k}
        }
      }
    }

def tak(x: Int, y: Int, z: Int): Int =
  cps_tak(x, y, z) { a => a }

def run(n: Int): Int = {
  val x = n
  val y = (2 * n) / 3
  val z = n / 3
  tak(x, y, z)
}

def main() = benchmark(18){run}
