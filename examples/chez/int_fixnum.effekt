import bench
import string

// On Chez, an Int is a fixnum (i61) with wrapping arithmetic.
def main() = {
  val max = 1152921504606846975
  println(max + 1)
  println(1152921504606846976)  // a literal that does not fit wraps the same way
  println(max * 2)
  println(bitwiseShl(1, 60))
  val before = timestamp()
  val after = timestamp()
  println(after - before >= 0)
  println(unsafeToInt("42"))
}
