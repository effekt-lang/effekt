// A loop called in the binding of a val returns to its body: the loop jumps there directly.

def main = { (n: Bool) =>
  def loop(b: Bool) = {
    if (b: Bool) {
      (loop : (Bool) => Int @ {})(false)
    } else {
      return 1
    }
  }
  val x = (loop : (Bool) => Int @ {})(n: Bool);
  return x: Int
}

/// IDENTIFY

def main(n: Bool) = {
  def loop(b: Bool) = {
    if (b: Bool) {
      loop: (Bool) => Int @ {}(false)
    } else {
      return 1
    }
  }
  def k(x: Int) = {
    return x: Int
  }
  val r = loop: (Bool) => Int @ {}(n: Bool);
  k: (Int) => Int @ {}(r: Int)
}

/// SINK

def main(n: Bool) = {
  def k(x: Int) = {
    return x: Int
  }
  val r = {
    def loop(b: Bool) = {
      if (b: Bool) {
        loop: (Bool) => Int @ {}(false)
      } else {
        return 1
      }
    }
    loop: (Bool) => Int @ {}(n: Bool)
  };
  k: (Int) => Int @ {}(r: Int)
}

/// RETURNS_TO

k ↦ ?
loop ↦ k

/// CONTIFY

def main(n: Bool) = {
  def k(x: Int) = {
    return x: Int
  }
  def loop(b: Bool) = {
    if (b: Bool) {
      loop: (Bool) => Int @ {}(false)
    } else {
      k: (Int) => Int @ {}(1)
    }
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// CLEANUP

def main(n: Bool) = {
  def loop(b: Bool) = {
    if (b: Bool) {
      loop: (Bool) => Int @ {}(false)
    } else {
      let x = 1
      return x: Int
    }
  }
  loop: (Bool) => Int @ {}(n: Bool)
}
