// The inner loop tail-calls the outer loop, so both return to the body of the val.

def main = { (n: Bool) =>
  def outer(a: Bool) = {
    def inner(b: Bool) = {
      if (b: Bool) {
        (inner : (Bool) => Int @ {})(false)
      } else {
        (outer : (Bool) => Int @ {})(false)
      }
    }
    if (a: Bool) {
      (inner : (Bool) => Int @ {})(true)
    } else {
      return 0
    }
  }
  val x = (outer : (Bool) => Int @ {})(n: Bool);
  return x: Int
}

/// IDENTIFY

def main(n: Bool) = {
  def outer(a: Bool) = {
    def inner(b: Bool) = {
      if (b: Bool) {
        inner: (Bool) => Int @ {}(false)
      } else {
        outer: (Bool) => Int @ {}(false)
      }
    }
    if (a: Bool) {
      inner: (Bool) => Int @ {}(true)
    } else {
      return 0
    }
  }
  def k(x: Int) = {
    return x: Int
  }
  val r = outer: (Bool) => Int @ {}(n: Bool);
  k: (Int) => Int @ {}(r: Int)
}

/// SINK

def main(n: Bool) = {
  def k(x: Int) = {
    return x: Int
  }
  val r = {
    def outer(a: Bool) = {
      if (a: Bool) {
        def inner(b: Bool) = {
          if (b: Bool) {
            inner: (Bool) => Int @ {}(false)
          } else {
            outer: (Bool) => Int @ {}(false)
          }
        }
        inner: (Bool) => Int @ {}(true)
      } else {
        return 0
      }
    }
    outer: (Bool) => Int @ {}(n: Bool)
  };
  k: (Int) => Int @ {}(r: Int)
}

/// RETURNS_TO

inner ↦ k
k ↦ ?
outer ↦ k

/// CONTIFY

def main(n: Bool) = {
  def k(x: Int) = {
    return x: Int
  }
  def outer(a: Bool) = {
    if (a: Bool) {
      def inner(b: Bool) = {
        if (b: Bool) {
          inner: (Bool) => Int @ {}(false)
        } else {
          outer: (Bool) => Int @ {}(false)
        }
      }
      inner: (Bool) => Int @ {}(true)
    } else {
      k: (Int) => Int @ {}(0)
    }
  }
  outer: (Bool) => Int @ {}(n: Bool)
}

/// CLEANUP

def main(n: Bool) = {
  def outer(a: Bool) = {
    if (a: Bool) {
      def inner(b: Bool) = {
        if (b: Bool) {
          inner: (Bool) => Int @ {}(false)
        } else {
          outer: (Bool) => Int @ {}(false)
        }
      }
      inner: (Bool) => Int @ {}(true)
    } else {
      let x = 0
      return x: Int
    }
  }
  outer: (Bool) => Int @ {}(n: Bool)
}
