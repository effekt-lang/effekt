// A frame around a shift moves into its resumption, which captures the frame anyway.

def main(b: Bool){p: Prompt[Int]} = {
  val x = shift (p: Prompt[Int] @ {p}) {{r: (Int) ~> Int} =>
    if (b: Bool) {
      resume (r: (Int) ~> Int @ {r}) { return 1 }
    } else {
      return 0
    }
  };
  return x: Int
}

/// IDENTIFY

def main(b: Bool){p @ p: Prompt[Int]} = {
  def k(x: Int) = {
    return x: Int
  }
  shift(p: Prompt[Int] @ {p}) {{r: (Int) ~> Int} => 
    if (b: Bool) {
      resume(r: (Int) ~> Int @ {r}) {
        k: (Int) => Int @ {}(1)
      }
    } else {
      return 0
    }
  }
}

/// PLACE

def main(b: Bool){p @ p: Prompt[Int]} = {
  def k(x: Int) = {
    return x: Int
  }
  shift(p: Prompt[Int] @ {p}) {{r: (Int) ~> Int} => 
    if (b: Bool) {
      resume(r: (Int) ~> Int @ {r}) {
        k: (Int) => Int @ {}(1)
      }
    } else {
      return 0
    }
  }
}

/// RETURNS_TO

k ↦ ?

/// CONTIFY

def main(b: Bool){p @ p: Prompt[Int]} = {
  def k(x: Int) = {
    return x: Int
  }
  shift(p: Prompt[Int] @ {p}) {{r: (Int) ~> Int} => 
    if (b: Bool) {
      resume(r: (Int) ~> Int @ {r}) {
        k: (Int) => Int @ {}(1)
      }
    } else {
      return 0
    }
  }
}

/// PARAMETRIZE

def main(b: Bool){p @ p: Prompt[Int]} = {
  def k(x: Int) = {
    return x: Int
  }
  shift(p: Prompt[Int] @ {p}) {{r: (Int) ~> Int} => 
    if (b: Bool) {
      resume(r: (Int) ~> Int @ {r}) {
        k: (Int) => Int @ {}(1)
      }
    } else {
      return 0
    }
  }
}

/// CLEANUP

def main(b: Bool){p @ p: Prompt[Int]} = {
  shift(p: Prompt[Int] @ {p}) {{r: (Int) ~> Int} => 
    if (b: Bool) {
      resume(r: (Int) ~> Int @ {r}) {
        let x = 1
        return x: Int
      }
    } else {
      return 0
    }
  }
}
