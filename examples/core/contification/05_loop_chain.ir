// A loop through two definitions from outside, one tail-calling the other: both sink behind the continuation, in their order.

def main = { (n: Bool) =>
  def g(y: Bool) = {
    if (y: Bool) {
      return false
    } else {
      return true
    }
  }
  def f(x: Bool) = {
    (g : (Bool) => Bool @ {})(x: Bool)
  }
  def loop(b: Bool) = {
    if (b: Bool) {
      val r = (f : (Bool) => Bool @ {})(b: Bool);
      (loop : (Bool) => Int @ {})(r: Bool)
    } else {
      return 0
    }
  }
  (loop : (Bool) => Int @ {})(n: Bool)
}

/// IDENTIFY

def main(n: Bool) = {
  def g(y: Bool) = {
    if (y: Bool) {
      return false
    } else {
      return true
    }
  }
  def f(x: Bool) = {
    g: (Bool) => Bool @ {}(x: Bool)
  }
  def loop(b: Bool) = {
    if (b: Bool) {
      def k(r: Bool) = {
        loop: (Bool) => Int @ {}(r: Bool)
      }
      val r = f: (Bool) => Bool @ {}(b: Bool);
      k: (Bool) => Int @ {}(r: Bool)
    } else {
      return 0
    }
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// RETURNS_TO

f ↦ k
g ↦ k
k ↦ ?
loop ↦ ?

/// CONTIFY

def main(n: Bool) = {
  def loop(b: Bool) = {
    if (b: Bool) {
      def k(r: Bool) = {
        loop: (Bool) => Int @ {}(r: Bool)
      }
      def g(y: Bool) = {
        if (y: Bool) {
          k: (Bool) => Int @ {}(false)
        } else {
          k: (Bool) => Int @ {}(true)
        }
      }
      def f(x: Bool) = {
        g: (Bool) => Int @ {}(x: Bool)
      }
      f: (Bool) => Int @ {}(b: Bool)
    } else {
      return 0
    }
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// CLEANUP

def main(n: Bool) = {
  def loop(b: Bool) = {
    if (b: Bool) {
      def k(r: Bool) = {
        loop: (Bool) => Int @ {}(r: Bool)
      }
      let x = b: Bool
      let y = x: Bool
      if (y: Bool) {
        k: (Bool) => Int @ {}(false)
      } else {
        k: (Bool) => Int @ {}(true)
      }
    } else {
      return 0
    }
  }
  loop: (Bool) => Int @ {}(n: Bool)
}
