// A loop whose continuation inside of it calls the loop again: the continuation floats up to the start of the loop,
// the definition returning there comes down after it, and what the continuation floated past becomes a parameter.

def main = { (n: Bool) =>
  def f(x: Bool) = {
    if (x: Bool) {
      return false
    } else {
      return true
    }
  }
  def loop(b: Bool) = {
    let c = n: Bool
    val r = (f : (Bool) => Bool @ {})(b: Bool);
    if (r: Bool) {
      (loop : (Bool) => Int @ {})(c: Bool)
    } else {
      return 0
    }
  }
  (loop : (Bool) => Int @ {})(n: Bool)
}

/// IDENTIFY

def main(n: Bool) = {
  def f(x: Bool) = {
    if (x: Bool) {
      return false
    } else {
      return true
    }
  }
  def loop(b: Bool) = {
    let c = n: Bool
    def k(r: Bool) = {
      if (r: Bool) {
        loop: (Bool) => Int @ {}(c: Bool)
      } else {
        return 0
      }
    }
    val r = f: (Bool) => Bool @ {}(b: Bool);
    k: (Bool) => Int @ {}(r: Bool)
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// PLACE

def main(n: Bool) = {
  def loop(b: Bool) = {
    def k(r: Bool) = {
      if (r: Bool) {
        loop: (Bool) => Int @ {}(c: Bool)
      } else {
        return 0
      }
    }
    def f(x: Bool) = {
      if (x: Bool) {
        return false
      } else {
        return true
      }
    }
    let c = n: Bool
    val r = f: (Bool) => Bool @ {}(b: Bool);
    k: (Bool) => Int @ {}(r: Bool)
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// RETURNS_TO

f ↦ k
k ↦ ?
loop ↦ ?

/// CONTIFY

def main(n: Bool) = {
  def loop(b: Bool) = {
    def k(r: Bool) = {
      if (r: Bool) {
        loop: (Bool) => Int @ {}(c: Bool)
      } else {
        return 0
      }
    }
    def f(x: Bool) = {
      if (x: Bool) {
        k: (Bool) => Int @ {}(false)
      } else {
        k: (Bool) => Int @ {}(true)
      }
    }
    let c = n: Bool
    f: (Bool) => Int @ {}(b: Bool)
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// PARAMETRIZE

def main(n: Bool) = {
  def loop(b: Bool) = {
    def k(r: Bool, c: Bool) = {
      if (r: Bool) {
        loop: (Bool) => Int @ {}(c: Bool)
      } else {
        return 0
      }
    }
    def f(x: Bool, c: Bool) = {
      if (x: Bool) {
        k: (Bool, Bool) => Int @ {}(false, c: Bool)
      } else {
        k: (Bool, Bool) => Int @ {}(true, c: Bool)
      }
    }
    let c = n: Bool
    f: (Bool, Bool) => Int @ {}(b: Bool, c: Bool)
  }
  loop: (Bool) => Int @ {}(n: Bool)
}

/// CLEANUP

def main(n: Bool) = {
  def loop(b: Bool) = {
    def k(r: Bool, c: Bool) = {
      if (r: Bool) {
        loop: (Bool) => Int @ {}(c: Bool)
      } else {
        return 0
      }
    }
    let c = n: Bool
    let x = b: Bool
    let c = c: Bool
    if (x: Bool) {
      k: (Bool, Bool) => Int @ {}(false, c: Bool)
    } else {
      k: (Bool, Bool) => Int @ {}(true, c: Bool)
    }
  }
  loop: (Bool) => Int @ {}(n: Bool)
}
