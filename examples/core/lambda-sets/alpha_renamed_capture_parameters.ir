interface Reader {
  read: () => Int
}

def run(){program @ c: (){reader: Reader} => Int} = {
  def source = new Reader {
    def read() = {
      return 0
    }
  }
  (program: (){reader: Reader} => Int @ {c})(){
    (source: Reader @ {})
  }
}

def forward(){program @ d: (){input: Reader} => Int} = {
  (run: (){program: (){reader: Reader} => Int} => Int @ {})(){
    (program: (){input: Reader} => Int @ {d})
  }
}

def main(n: Int) = {
  (forward: (){program: (){input: Reader} => Int} => Int @ {})(){
    (){actual: Reader} => {
      return n: Int
    }
  }
}

// The actual and formal function types differ only in the names of their
// bound capture parameters. The singleton lambda set is nevertheless known,
// so its captured value is passed directly without a nominal closure.
/// LAMBDA_SPECIALIZE

interface Reader {
  read: () => Int
}

def run(){program @ c: (){reader: Reader} => Int} = {
  def source = new Reader {
    def read() = {
      return 0
    }
  }
  (program: (){reader: Reader} => Int @ {c})(){
    (source: Reader @ {})
  }
}

def forward(){program @ d: (){input: Reader} => Int} = {
  (run: (){program: (){reader: Reader} => Int} => Int @ {})(){
    (program: (){input: Reader} => Int @ {d})
  }
}

def main(n: Int) = {
  (forward_specialized: (Int) => Int @ {})(n: Int)
}

def forward_specialized(program_environment: Int) = {
  (run_specialized: (Int) => Int @ {})(program_environment: Int)
}

def run_specialized(program_environment: Int) = {
  def source = new Reader {
    def read() = {
      return 0
    }
  }
  (program_specialized: (Int) => Int @ {})(program_environment: Int)
}

def program_specialized(n_captured: Int) = {
  return n_captured: Int
}
