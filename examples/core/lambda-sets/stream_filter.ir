type ListInt {
  Nil()
  Cons(head: Int, tail: ListInt)
}
interface Emit {
  emit: (Int) => Unit
}

def stream(input: ListInt){emit: Emit} = {
  input: ListInt match[Unit] {
    Nil : { () => return () }
    Cons : { (x: Int, xs: ListInt) =>
      val ignored = (emit: Emit @ {emit}).emit: (Int) => Unit(x: Int);
      (stream: (ListInt){emit: Emit} => Unit @ {})(xs: ListInt){
        (emit: Emit @ {emit})
      }
    }
  }
}

def unstream(){producer: (){emit: Emit} => Unit} = {
  reset { (){prompt: Prompt[ListInt]} =>
    def emit = new Emit {
      def emit(x: Int) = {
        shift (prompt: Prompt[ListInt] @ {prompt}) {{continuation: Resume[Unit, ListInt]} =>
          val tail = resume (continuation: Resume[Unit, ListInt] @ {continuation}) { return () };
          return make ListInt Cons(x: Int, tail: ListInt)
        }
      }
    }
    val ignored = (producer: (){emit: Emit} => Unit @ {producer})(){
      (emit: Emit @ {emit})
    };
    return make ListInt Nil()
  }
}

def sfilter(){keep: (Int) => Bool} {producer: (){emit: Emit} => Unit} {emit: Emit} = {
  def filtered = new Emit {
    def emit(x: Int) = {
      val retain = (keep: (Int) => Bool @ {keep})(x: Int);
      if (retain: Bool) {
        (emit: Emit @ {emit}).emit: (Int) => Unit(x: Int)
      } else {
        return ()
      }
    }
  }
  (producer: (){emit: Emit} => Unit @ {producer})(){
    (filtered: Emit @ {filtered})
  }
}

def filter(input: ListInt){keep: (Int) => Bool} = {
  (unstream: (){producer: (){emit: Emit} => Unit} => ListInt @ {})(){
    (){output: Emit} =>
      (sfilter: (){keep: (Int) => Bool}{producer: (){emit: Emit} => Unit}{emit: Emit} => Unit @ {})(){
        (keep: (Int) => Bool @ {keep})
      }{
        (){inputEmit: Emit} =>
          (stream: (ListInt){emit: Emit} => Unit @ {})(input: ListInt){
            (inputEmit: Emit @ {inputEmit})
          }
      }{
        (output: Emit @ {output})
      }
  }
}

def main() = {
  def even(x: Int) = { return true }
  (filter: (ListInt){keep: (Int) => Bool} => ListInt @ {})(
    make ListInt Cons(1, make ListInt Cons(2, make ListInt Nil()))){
      (even: (Int) => Bool @ {})
    }
}

/// LAMBDA_SETS

S = emit.emit ↦ { <?> },
    even ↦ { <> },
    filter ↦ { <even> },
    filtered.emit ↦ { <emit, even> },
    lambda1 ↦ { <even, emit> },
    lambda2 ↦ { <filtered> },
    sfilter ↦ { <even, lambda2, emit> },
    stream ↦ { <filtered> },
    unstream ↦ { <lambda1> }

