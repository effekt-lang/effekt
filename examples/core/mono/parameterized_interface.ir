interface On['A] {}

def use['A](){on: On['A]} = {
  return ()
}

def main(){on: On[Int]} = {
  (use: ['A](){on: On['A]} => Unit @ {})[Int](){on: On[Int] @ {on}}
}

/// MONO_COLLECT_CONSTRAINTS

<Int> <: On
<Int> <: use
<use.0> <: On

/// MONO_SOLVE

S = On ↦ { <Int> },
    use ↦ { <Int> }

/// MONO_SPECIALIZE

interface OnInt {}

