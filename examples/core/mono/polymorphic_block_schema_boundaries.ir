/// MONO_PREPROCESS

interface Poly['A] {
  apply: ['B]('A, 'A, 'B) => 'B
}

interface Poly1 {
  apply1: ['A]('A) => 'A
}

interface Poly2 {
  apply2: ['A]('A, 'A) => 'A
}

def repeated['A, 'Unused](){f: Poly['A]} = {
  return ()
}

def renamed['X](){f: Poly['X]} = {
  return ()
}

def unary(){f: Poly1} = {
  return ()
}

def binary(){f: Poly2} = {
  return ()
}

def pair(){left: Poly1}{right: Poly1} = {
  return ()
}
