// A definition always returns the state; the body of the var drops it again.

def main = { (n: Bool) =>
  var x @ c = 0;
  def loop(b: Bool) = {
    if (b: Bool) {
      put x @ c = 1;
      (loop : (Bool) => Int @ {c})(false)
    } else {
      get r: Int = !x @ c;
      return r: Int
    }
  }
  (loop : (Bool) => Int @ {c})(n: Bool)
}

/// REFERENCES_TO_PARAMETERS

def main = { (n: Bool) =>
  let x0 = 0
  def loop(b: Bool, x1: Int) = {
    if (b: Bool) {
      let x2 = 1
      (loop : (Bool, Int) => (Int, Int) @ {})(false, x2: Int)
    } else {
      let r = x1: Int
      return r: Int, x1: Int
    }
  }
  val y, x3 = (loop : (Bool, Int) => (Int, Int) @ {})(n: Bool, x0: Int);
  return y: Int
}
