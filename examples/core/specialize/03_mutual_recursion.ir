// The copies of ping and pong for the lambda would call each other; pong's copy comes first, so its call of ping
// closes the cycle and stays a call of the original ping.

def ping(b: Bool){f: (Int) => Int} = {
  if (b: Bool) {
    (f: (Int) => Int @ {f})(1)
  } else {
    (pong: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
  }
}

def pong(b: Bool){f: (Int) => Int} = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
}

def main(b: Bool, n: Int) = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return n: Int
  }
}

/// SPECIALIZE

def ping(b: Bool){f @ f: (Int) => Int} = {
  if (b: Bool) {
    f: (Int) => Int @ {f}(1)
  } else {
    pong: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
  }
}
def pong(b: Bool){f @ f: (Int) => Int} = {
  ping: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
}
def main(b: Bool, n: Int) = {
  def f(x: Int) = {
    return n: Int
  }
  let c = b: Bool
  if (c: Bool) {
    f: (Int) => Int @ {}(1)
  } else {
    let d = c: Bool
    ping: (Bool){f: (Int) => Int} => Int @ {}(d: Bool){f: (Int) => Int @ {}}
  }
}
