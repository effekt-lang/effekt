// The shapes propagate into the copies: ping asks for pong with the same block, which asks for ping again.

def ping(b: Bool){f: (Int) => Int} = {
  if (b: Bool) {
    (f: (Int) => Int @ {f})(1)
  } else {
    (pong: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
  }
}

def pong(b: Bool){f: (Int) => Int} = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
}

def main(b: Bool, n: Int) = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return n: Int
  }
}

/// INSTANCES

ping ↦ [f]
pong ↦ [f]

/// SPECIALIZE

def ping(b: Bool){f @ f: (Int) => Int} = {
  if (b: Bool) {
    f: (Int) => Int @ {f}(1)
  } else {
    pong: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
  }
}
def pong(b: Bool){f @ f: (Int) => Int} = {
  ping: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
}
def main(b: Bool, n: Int) = {
  def f(x: Int) = {
    return n: Int
  }
  ping_f: (Bool, Int) => Int @ {}(b: Bool, n: Int)
}
def ping_f(b: Bool, n: Int) = {
  def f(x: Int) = {
    return n: Int
  }
  if (b: Bool) {
    f: (Int) => Int @ {f}(1)
  } else {
    pong_f: (Bool, Int) => Int @ {f}(b: Bool, n: Int)
  }
}
def pong_f(b: Bool, n: Int) = {
  def f(x: Int) = {
    return n: Int
  }
  ping_f: (Bool, Int) => Int @ {f}(b: Bool, n: Int)
}
