// The copies of ping and pong for the lambda call each other. The copy of ping enters the group, so it gets the copy
// of pong at its beginning, where pong's copy calls it back; ping's copy is called once and goes away again.

def ping(b: Bool){f: (Int) => Int} = {
  if (b: Bool) {
    (f: (Int) => Int @ {f})(1)
  } else {
    (pong: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
  }
}

def pong(b: Bool){f: (Int) => Int} = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
}

def main(b: Bool, n: Int) = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return n: Int
  }
}

/// SPECIALIZE

def ping(b: Bool){f @ f: (Int) => Int} = {
  if (b: Bool) {
    f: (Int) => Int @ {f}(1)
  } else {
    pong: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
  }
}
def pong(b: Bool){f @ f: (Int) => Int} = {
  ping: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
}
def main(b: Bool, n: Int) = {
  def f(x: Int) = {
    return n: Int
  }
  def pong_f(d: Bool) = {
    let e = d: Bool
    if (e: Bool) {
      f: (Int) => Int @ {}(1)
    } else {
      pong_f: (Bool) => Int @ {}(e: Bool)
    }
  }
  let c = b: Bool
  if (c: Bool) {
    f: (Int) => Int @ {}(1)
  } else {
    pong_f: (Bool) => Int @ {}(c: Bool)
  }
}
