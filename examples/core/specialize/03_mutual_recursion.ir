// The copy of ping for the lambda sits right after it; it asks for pong with the same block, whose copy is not in
// scope, so it sits at the beginning of ping's copy, where it sees ping's copy and calls it.

def ping(b: Bool){f: (Int) => Int} = {
  if (b: Bool) {
    (f: (Int) => Int @ {f})(1)
  } else {
    (pong: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
  }
}

def pong(b: Bool){f: (Int) => Int} = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){f: (Int) => Int @ {f}}
}

def main(b: Bool, n: Int) = {
  (ping: (Bool){f: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return n: Int
  }
}

/// SPECIALIZE

def ping(b: Bool){f @ f: (Int) => Int} = {
  if (b: Bool) {
    f: (Int) => Int @ {f}(1)
  } else {
    pong: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
  }
}
def pong(b: Bool){f @ f: (Int) => Int} = {
  ping: (Bool){f: (Int) => Int} => Int @ {}(b: Bool){f: (Int) => Int @ {f}}
}
def main(b: Bool, n: Int) = {
  def ping_f(b: Bool) = {
    if (b: Bool) {
      let x = 1
      return n: Int
    } else {
      let c = b: Bool
      ping_f: (Bool) => Int @ {}(c: Bool)
    }
  }
  ping_f: (Bool) => Int @ {}(b: Bool)
}
