// A block built up recursively captures a block from the same definition, which it then captures as unknown.

def loop(b: Bool){k: (Int) => Int} = {
  if (b: Bool) {
    (k: (Int) => Int @ {k})(0)
  } else {
    (loop: (Bool){k: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
      (k: (Int) => Int @ {k})(x: Int)
    }
  }
}

def main(b: Bool) = {
  (loop: (Bool){k: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return x: Int
  }
}

/// INSTANCES

loop ↦ [f(?)]
loop ↦ [f(f)]
loop ↦ [f]

/// SPECIALIZE

def loop(b: Bool){k @ k: (Int) => Int} = {
  if (b: Bool) {
    k: (Int) => Int @ {k}(0)
  } else {
    def g(x: Int) = {
      k: (Int) => Int @ {k}(x: Int)
    }
    loop_g: (Bool){k: (Int) => Int} => Int @ {k}(b: Bool){k: (Int) => Int @ {k}}
  }
}
def main(b: Bool) = {
  def f(x: Int) = {
    return x: Int
  }
  loop_f: (Bool) => Int @ {}(b: Bool)
}
def loop_g(b: Bool){k @ k: (Int) => Int} = {
  def g(x: Int) = {
    k: (Int) => Int @ {k}(x: Int)
  }
  if (b: Bool) {
    g: (Int) => Int @ {g}(0)
  } else {
    def h(x: Int) = {
      g: (Int) => Int @ {g}(x: Int)
    }
    loop_g: (Bool){k: (Int) => Int} => Int @ {g}(b: Bool){g: (Int) => Int @ {g}}
  }
}
def loop_f(b: Bool) = {
  def f(x: Int) = {
    return x: Int
  }
  if (b: Bool) {
    f: (Int) => Int @ {f}(0)
  } else {
    def g(x: Int) = {
      f: (Int) => Int @ {f}(x: Int)
    }
    loop_gf: (Bool) => Int @ {f}(b: Bool)
  }
}
def loop_gf(b: Bool) = {
  def f(x: Int) = {
    return x: Int
  }
  def g(x: Int) = {
    f: (Int) => Int @ {}(x: Int)
  }
  if (b: Bool) {
    g: (Int) => Int @ {g}(0)
  } else {
    def h(x: Int) = {
      g: (Int) => Int @ {g}(x: Int)
    }
    loop_g: (Bool){k: (Int) => Int} => Int @ {g}(b: Bool){g: (Int) => Int @ {g}}
  }
}
