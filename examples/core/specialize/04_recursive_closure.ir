// A block built up recursively captures a block from the same definition, which it then captures as unknown.

def loop(b: Bool){k: (Int) => Int} = {
  if (b: Bool) {
    (k: (Int) => Int @ {k})(0)
  } else {
    (loop: (Bool){k: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
      (k: (Int) => Int @ {k})(x: Int)
    }
  }
}

def main(b: Bool) = {
  (loop: (Bool){k: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return x: Int
  }
}

/// INSTANCES

loop ↦ [f(?)]
loop ↦ [f(f)]
loop ↦ [f]

/// SPECIALIZE

def loop(b: Bool){k @ k: (Int) => Int} = {
  if (b: Bool) {
    k: (Int) => Int @ {k}(0)
  } else {
    loop_g: (Bool){k: (Int) => Int} => Int @ {k}(b: Bool){k: (Int) => Int @ {k}}
  }
}
def main(b: Bool) = {
  if (b: Bool) {
    let x = 0
    return x: Int
  } else {
    def g(y: Int) = {
      let x = y: Int
      return x: Int
    }
    if (b: Bool) {
      g: (Int) => Int @ {}(0)
    } else {
      loop_g: (Bool){k: (Int) => Int} => Int @ {}(b: Bool){g: (Int) => Int @ {}}
    }
  }
}
def loop_g(b: Bool){k @ k: (Int) => Int} = {
  def g(x: Int) = {
    k: (Int) => Int @ {k}(x: Int)
  }
  if (b: Bool) {
    g: (Int) => Int @ {k}(0)
  } else {
    loop_g: (Bool){k: (Int) => Int} => Int @ {k}(b: Bool){g: (Int) => Int @ {k}}
  }
}
