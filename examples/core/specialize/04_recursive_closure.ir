// A copy of loop for a block defined at the same place as the block of a copy of loop we are in would be built up
// recursively, so the call stays a call to the original loop.

def loop(b: Bool){k: (Int) => Int} = {
  if (b: Bool) {
    (k: (Int) => Int @ {k})(0)
  } else {
    (loop: (Bool){k: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
      (k: (Int) => Int @ {k})(x: Int)
    }
  }
}

def main(b: Bool) = {
  (loop: (Bool){k: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return x: Int
  }
}

/// SPECIALIZE

def loop(b: Bool){k @ k: (Int) => Int} = {
  if (b: Bool) {
    k: (Int) => Int @ {k}(0)
  } else {
    def g(x: Int) = {
      k: (Int) => Int @ {k}(x: Int)
    }
    let c = b: Bool
    if (c: Bool) {
      g: (Int) => Int @ {k}(0)
    } else {
      def h(x: Int) = {
        g: (Int) => Int @ {k}(x: Int)
      }
      loop: (Bool){k: (Int) => Int} => Int @ {}(c: Bool){h: (Int) => Int @ {k}}
    }
  }
}
def main(b: Bool) = {
  def f(x: Int) = {
    return x: Int
  }
  let c = b: Bool
  if (c: Bool) {
    f: (Int) => Int @ {}(0)
  } else {
    def g(x: Int) = {
      f: (Int) => Int @ {}(x: Int)
    }
    let d = c: Bool
    if (d: Bool) {
      g: (Int) => Int @ {}(0)
    } else {
      def h(x: Int) = {
        g: (Int) => Int @ {}(x: Int)
      }
      loop: (Bool){k: (Int) => Int} => Int @ {}(d: Bool){h: (Int) => Int @ {}}
    }
  }
}
