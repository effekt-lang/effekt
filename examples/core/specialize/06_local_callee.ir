// A local definition is specialized like a toplevel one; what it captures becomes parameters of its copy.

def main(n: Int) = {
  def run(){h: (Int) => Int} = {
    (h: (Int) => Int @ {h})(n: Int)
  }
  (run: (){h: (Int) => Int} => Int @ {})(){(x: Int) =>
    return x: Int
  }
}

/// INSTANCES

run ↦ [f]

/// SPECIALIZE

def x0(x2: Int) = {
  def x3(){x5 @ x5: (Int) => Int} = {
    x5: (Int) => Int @ {x5}(x2: Int)
  }
  def x6(x7: Int) = {
    return x7: Int
  }
  x1: (Int) => Int @ {}(x2: Int)
}
def x1(x8: Int) = {
  def x9(){x11 @ x11: (Int) => Int} = {
    x11: (Int) => Int @ {x11}(x8: Int)
  }
  def x12(x13: Int) = {
    return x13: Int
  }
  x12: (Int) => Int @ {x12}(x8: Int)
}
