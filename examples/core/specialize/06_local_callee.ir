// A local definition is specialized like a toplevel one; what it captures becomes parameters of its copy.

def main(n: Int) = {
  def run(){h: (Int) => Int} = {
    (h: (Int) => Int @ {h})(n: Int)
  }
  (run: (){h: (Int) => Int} => Int @ {})(){(x: Int) =>
    return x: Int
  }
}

/// INSTANCES

run ↦ [f]

/// SPECIALIZE

def main(n: Int) = {
  run_f: (Int) => Int @ {}(n: Int)
}
def run_f(n: Int) = {
  let x = n: Int
  return x: Int
}
