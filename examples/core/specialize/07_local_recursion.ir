// A local definition calling itself with the same known block calls its copy again: in the copy, its own name is
// bound to the definition and known by the instance. The copy moves into `main`, where `b` and `n` are visible,
// so all its parameters are dropped.

def main(b: Bool, n: Int) = {
  def loop(c: Bool){h: (Int) => Int} = {
    if (c: Bool) {
      (h: (Int) => Int @ {h})(n: Int)
    } else {
      (loop: (Bool){h: (Int) => Int} => Int @ {})(b: Bool){h: (Int) => Int @ {h}}
    }
  }
  (loop: (Bool){h: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return x: Int
  }
}

/// INSTANCES

loop ↦ [f]

/// SPECIALIZE

def main(b: Bool, n: Int) = {
  def loop_f() = {
    if (b: Bool) {
      let x = n: Int
      return x: Int
    } else {
      loop_f: () => Int @ {}()
    }
  }
  loop_f: () => Int @ {}()
}
