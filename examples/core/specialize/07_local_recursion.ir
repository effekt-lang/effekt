// A local definition calling itself with the same known block calls its copy again: in the copy, its own name is
// bound to the definition and known by the instance.

def main(b: Bool, n: Int) = {
  def loop(c: Bool){h: (Int) => Int} = {
    if (c: Bool) {
      (h: (Int) => Int @ {h})(n: Int)
    } else {
      (loop: (Bool){h: (Int) => Int} => Int @ {})(b: Bool){h: (Int) => Int @ {h}}
    }
  }
  (loop: (Bool){h: (Int) => Int} => Int @ {})(b: Bool){(x: Int) =>
    return x: Int
  }
}

/// INSTANCES

loop ↦ [f]

/// SPECIALIZE

def main(b: Bool, n: Int) = {
  def loop(c: Bool){h @ h: (Int) => Int} = {
    if (c: Bool) {
      h: (Int) => Int @ {h}(n: Int)
    } else {
      loop: (Bool){h: (Int) => Int} => Int @ {}(b: Bool){h: (Int) => Int @ {h}}
    }
  }
  def f(x: Int) = {
    return x: Int
  }
  loop_f: (Bool, Bool, Int) => Int @ {}(b: Bool, b: Bool, n: Int)
}
def loop_f(c: Bool, b: Bool, n: Int) = {
  def loop(c: Bool){h @ h: (Int) => Int} = {
    if (c: Bool) {
      h: (Int) => Int @ {h}(n: Int)
    } else {
      loop: (Bool){h: (Int) => Int} => Int @ {}(b: Bool){h: (Int) => Int @ {h}}
    }
  }
  def f(x: Int) = {
    return x: Int
  }
  if (c: Bool) {
    f: (Int) => Int @ {f}(n: Int)
  } else {
    loop_f: (Bool, Bool, Int) => Int @ {f}(b: Bool, b: Bool, n: Int)
  }
}
