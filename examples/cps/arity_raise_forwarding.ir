def consume(xs, k) {
  xs match {
    case Nil() => k(0)
    case Cons(head, tail) => k(head)
  }
}
def forward(xs, k) {
  consume(xs, k)
}
def main(k) {
  forward(make Cons(42, make Nil()), k)
}

// Representation demand propagates backwards through known calls.
/// ARITY_SHAPES

consume
  <Cons(_, _), ?>
forward
  <Cons(_, _), ?>

/// ARITY_RAISE

def consume_0_Cons(xs_0, xs_1, k) {
  k(xs_0)
}
def forward_0_Cons(xs_0, xs_1, k) {
  consume_0_Cons(xs_0, xs_1, k)
}
def main(k) {
  forward_0_Cons(42, make Nil(), k)
}
