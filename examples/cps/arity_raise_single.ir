type ListData { Nil() Cons(head: Int, tail: ListData) }

def use(xs, k) {
  xs match {
    case Nil() => k(0)
    case Cons(head, tail) => k(head)
  }
}
def main(k) {
  use(make Cons(42, make Nil()), k)
}

/// ARITY_SHAPES

use
  <Cons(_, _), ?>

/// ARITY_RAISE

def use(xs_0, xs_1, k) {
  k(xs_0)
}
def main(k) {
  use(42, make Nil(), k)
}
