type ListData { Nil() Cons(head: Int, tail: ListData) }

def main(ks0, k0) {
  reset(p, ks, k) {
    let input = make Cons(1, make Cons(2, make Nil()));
    def stream(input1, ks1) {
      input1 match {
        case Nil() => k(make Nil(), ks1)
        case Cons(x, xs) => {
          run keep = eq(x, 2);
          if (keep) {
            def next(_, ks2) {
              stream(xs, ks2)
            }
            shift(p) { resumeK, ks3, k3 =>
              def prepend(tail, ks4) {
                k3(make Cons(x, tail), ks4)
              }
              resume(resumeK) { ks5, k5 =>
                k5((), ks5)
              } @ ks3, prepend
            } @ ks1, next
          } else {
            stream(xs, ks1)
          }
        }
      }
    }
    stream(input, ks)
  } @ ks0, k0
}

// This is the fused stream/filter/unstream worker produced for issue1064.
// The recursive input can be either Nil or Cons, so monovariant arity raising
// must retain its boxed list representation.
/// ARITY_RAISE

def main(ks0, k0) {
  reset(p, ks, k) {
    let input = make Cons(1, make Cons(2, make Nil()));
    def stream(input1, ks1) {
      input1 match {
        case Nil() => k(make Nil(), ks1)
        case Cons(x, xs) => {
          run keep = eq(x, 2);
          if (keep) {
            def next(_, ks2) {
              stream(xs, ks2)
            }
            shift(p) { resumeK, ks3, k3 =>
              def prepend(tail, ks4) {
                k3(make Cons(x, tail), ks4)
              }
              resume(resumeK) { ks5, k5 =>
                k5((), ks5)
              } @ ks3, prepend
            } @ ks1, next
          } else {
            stream(xs, ks1)
          }
        }
      }
    }
    stream(input, ks)
  } @ ks0, k0
}

