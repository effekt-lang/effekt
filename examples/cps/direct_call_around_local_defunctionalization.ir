def program(n, ks, k) {
  def build(i, ks1, k1) {
    run done = eq(i, 0);
    if (done) {
      k1(i, ks1)
    } else {
      run previous = sub(i, 1);
      let value = build!(previous, ks1, return);
      run result = add(value, 1);
      k1(result, ks1)
    }
  }
  let result = build!(n, ks, return);
  k(result, ks)
}
def main(n, ks, k) {
  let result = program!(n, ks, return);
  k(result, ks)
}

// `build` is a closed local continuation machine and is lowered to a
// stack-safe defunctionalized loop. The surrounding `program` therefore has
// a direct value-returning interface whose distinguished case returns the
// result instead of retaining CPS solely because `build` is recursive.
/// CALLING_CONVENTIONS

