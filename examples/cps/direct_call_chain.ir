def inc(x, ks, k) {
  run y = add(x, 1);
  k(y, ks)
};
def twice(x, ks, k) {
  let first = inc!(x, ks, return);
  let second = inc!(first, ks, return);
  k(second, ks)
};
def main(x, ks, k) {
  let result = twice!(x, ks, return);
  k(result, ks)
}

/// CALLING_CONVENTIONS

direct
  inc = 0
  main = 2 adapter
  twice = 1

/// JAVASCRIPT

function inc_0(x_0) {
  const y_0 = add_0(x_0, 1);
  return y_0;
}

function twice_0(x_1) {
  const first_0 = inc_0(x_1);
  const second_0 = inc_0(first_0);
  return second_0;
}

function main_0(x_2, ks_0, k_0) {
  const result_0 = twice_0(x_2);
  return k_0(result_0, ks_0);
}
