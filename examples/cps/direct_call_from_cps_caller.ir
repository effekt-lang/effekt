def main(f, x, ks, k) {
  def identity(y, ks1, k1) {
    k1(y, ks1)
  }
  let result = identity!(x, ks, return);
  f(result, ks, k)
}

// The caller retains CPS because `f` is unknown. This does not prevent the
// known finite-rank call to `identity` from becoming a structured local
// region. No JavaScript function is needed.
/// CALLING_CONVENTIONS

direct
  identity = 0

/// JAVASCRIPT

function main_0(f_0, x_0, ks_0, k_0) {
  let result_0 = undefined;
  identity_return_0: {
    result_0 = x_0;
  }
  return f_0(result_0, ks_0, k_0);
}
