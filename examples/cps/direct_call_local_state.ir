def main(n, ks, k) {
  def stateful(value, ks1, k1) {
    var cell = value @ ks1;
    get result = cell;
    k1(result, ks1)
  }
  let result = stateful!(n, ks, return);
  k(result, ks)
}

// A non-escaping reference associated with the current meta-continuation is
// local state, not a control boundary, and therefore admits direct style.
/// CALLING_CONVENTIONS

direct
  main = 0 adapter
  stateful = 0

/// JAVASCRIPT

function main_0(n_0, ks_0, k_0) {
  let result_0 = undefined;
  stateful_return_0: {
    let cell_0 = n_0;
    const result_1 = cell_0;
    result_0 = result_1;
  }
  return k_0(result_0, ks_0);
}
