def main(n, ks, k) {
  def stateful(value, ks1, k1) {
    var state = value @ ks1;
    def loop() {
      get current = state;
      run done = eq(current, 0);
      if (done) {
        k1(current)
      } else {
        run next = sub(current, 1);
        put state = next;
        loop()
      }
    }
    loop()
  }
  let result = stateful!(n, ks, return);
  k(result, ks)
}

// Parameter dropping turns the recursive worker into a nullary lexical
// block. Its tail call and one-argument continuation application are still
// part of `stateful`'s control region, so neither prevents a direct boundary.
/// CALLING_CONVENTIONS

direct
  main = 0 adapter
  stateful = 0

/// JAVASCRIPT

