def duplicate(x, ks1, k1) {
  k1(x, x, ks1)
}
def main(x, ks, k) {
  run ignored = println(duplicate);
  let (a, b) = duplicate!(x, ks, return);
  k(a, ks)
}

// A direct worker packages its results in an array. Its CPS-facing adapter
// immediately unpacks that array and resumes with the original result arity.
/// CALLING_CONVENTIONS

direct
  duplicate = 0 adapter
  main = 1 adapter

/// JAVASCRIPT

function duplicate_0(x_0) {
  return [x_0, x_0];
}

function duplicate_cps_0(x_0, ks_0, k_0) {
  const [result_0, result_1] = duplicate_0(x_0);
  return k_0(result_0, result_1, ks_0);
}

function main_0(x_1, ks_1, k_1) {
  const ignored_0 = println_0(duplicate_cps_0);
  const [a_0, b_0] = duplicate_0(x_1);
  return k_1(a_0, ks_1);
}
