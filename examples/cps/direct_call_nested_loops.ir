def main(flag, value, ks, k) {
  def outer(active, current, ks1, k1) {
    if (active) {
      def inner(recur, nested, ks2, k2) {
        if (recur) {
          let result = inner!(false, nested, ks2, return);
          k2(result, ks2)
        } else {
          let result = outer!(false, nested, ks2, return);
          k2(result, ks2)
        }
      }
      let result = inner!(true, current, ks1, return);
      k1(result, ks1)
    } else {
      k1(current, ks1)
    }
  }
  let result = outer!(flag, value, ks, return);
  k(result, ks)
}

// The unique forward entries follow lexical nesting. The remaining edges are
// tail transfers to the same or an enclosing definition, so the recursive
// component is reducible to nested loops.
/// CALLING_CONVENTIONS

direct
  inner = 0
  main = 0 adapter
  outer = 0

/// JAVASCRIPT

function main_0(flag_0, value_0, ks_0, k_0) {
  let active_0 = flag_0;
  let current_0 = value_0;
  let result_0 = undefined;
  outer_return_0: {
