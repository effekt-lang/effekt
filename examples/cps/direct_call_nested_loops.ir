        let recur_0 = true;
        let nested_0 = current_0;
        let result_1 = undefined;
        inner_return_0: {
          inner_0: while (true) {
            if (recur_0) {
              const next_arg_0 = false;
              recur_0 = next_arg_0;
              continue inner_0;
            } else {
              const next_arg_1 = false;
              const next_arg_2 = nested_0;
              active_0 = next_arg_1;
              current_0 = next_arg_2;
              continue outer_0;
            }
          }
        }
        result_0 = result_1;
        break outer_return_0;
      } else {
        result_0 = current_0;
        break outer_return_0;
      }
    }
  }
  return k_0(result_0, ks_0);
}
