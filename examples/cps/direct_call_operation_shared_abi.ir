def use(random, ks, k) {
  let result = random.random!(ks, return);
  k(result, ks)
}

def main(flag, fallback, ks, k) {
  new direct : Random {
    def random(ks1, k1) = { k1(1, ks1) }
  }
  new cps : Random {
    def random(ks2, k2) = { fallback(ks2, k2) }
  }
  let ignored = direct.random!(ks, return);
  if (flag) {
    use(direct, ks, k)
  } else {
    use(cps, ks, k)
  }
}

// The first invocation alone demands a direct implementation of
// `direct.random`. The later dynamic invocation can also select `cps.random`,
// which cannot return directly. Since an object exposes one property for the
// method, both implementations must agree on the CPS ABI.
/// CALLING_CONVENTIONS

-

