def loop(i, ks, k) {
  if (true) {
    let result = loop!(i, ks, return);
    k(result, ks)
  } else {
    k(i, ks)
  }
};
def main(i, ks, k) {
  let result = loop!(i, ks, return);
  k(result, ks)
}

/// CALLING_CONVENTIONS

direct
  loop = 0
  main = 1 adapter

/// JAVASCRIPT

function loop_0(i_0) {
  loop_0: while (true) {
    if (true) {
      continue loop_0;
    } else {
      return i_0;
    }
  }
}

function main_0(i_1, ks_0, k_0) {
  const result_0 = loop_0(i_1);
  return k_0(result_0, ks_0);
}
