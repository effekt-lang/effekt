def main(flag, f, x, ks, k) {
  def choose(value, ks1, k1) {
    if (flag) {
      k1(value, ks1)
    } else {
      k1(0, ks1)
    }
  }
  let result = choose!(x, ks, return);
  f(result, ks, k)
}

// `choose` has one call site but two result exits. Commuting it into its use
// would copy the remainder into both branches, so it remains a direct local
// function. The restriction makes repeated commuting conversions linear in
// the size of the program.
/// CALLING_CONVENTIONS

direct
  choose = 0

/// JAVASCRIPT

function main_0(flag_0, f_0, x_0, ks_0, k_0) {
  function direct_0(value_0) {
    if (flag_0) {
      return value_0;
    } else {
      return 0;
    }
  }
  const result_0 = direct_0(x_0);
  return f_0(result_0, ks_0, k_0);
}
