def main(which, choice, k) {
  def constant(x_constant) {
    k(x_constant)
  }
  def varying(x_varying) {
    k(x_varying)
  }
  if (which) {
    constant(42)
  } else {
    if (choice) {
      varying(0)
    } else {
      varying(1)
    }
  }
}

/// EQUALITIES

main
---
constant:
  entry x_constant = 42
  recursive -
varying:
  entry -
  recursive -

/// JAVASCRIPT

function main_0(which_0, choice_0, k_0) {
  let x_constant_0 = undefined;
  constant_0: {
    let x_varying_0 = undefined;
    if (which_0) {
      x_constant_0 = 42;
      break constant_0;
    } else if (choice_0) {
      x_varying_0 = 0;
    } else {
      x_varying_0 = 1;
    }
    return k_0(x_varying_0);
  }
  return k_0(x_constant_0);
}
