def rec(n, self) {
  self(n, self)
}
def main() {
  // here is exactly one call, but we also refer to rec a second time
  rec(10, rec)
}

/// INLINE
// Should not do anything

def rec(n, self) {
  self(n, self)
}
def main() {
  rec(10, rec)
}

/// SINK_BLOCKS

def main() {
  def rec(n, self) {
    self(n, self)
  }
  rec(10, rec)
}

/// DROP_PARAMETERS

def main() {
  def rec(self) {
    self(self)
  }
  rec(rec)
}
