type TripleData { Triple(first: Int, second: Int, third: Int) }

def main(i, ks, k) {
  def boxed(i1, ks1, k1) {
    run done = eq(i1, 0);
    if (done) {
      k1(make Triple(i1, i1, i1), ks1)
    } else {
      run previous = sub(i1, 1);
      let recursive = boxed!(previous, ks1, return);
      recursive match {
        case Triple(value, second, third) => {
          run next = add(value, 1);
          k1(make Triple(next, second, third), ks1)
        }
      }
    }
  }
  let result = boxed!(i, ks, return);
  result match {
    case Triple(value, second, third) => k(value, ks)
  }
}

