type ListData { Nil() Cons(head: Int, tail: ListData) }

def main(n, ks, k) {
  def produce(i, ks1, k1) {
    run done = eq(i, 0);
    if (done) {
      k1(make Nil(), ks1)
    } else {
      run previous = sub(i, 1);
      let tail = produce!(previous, ks1, return);
      k1(make Cons(i, tail), ks1)
    }
  }
  def consume(xs, ks2, k2) {
    xs match {
      case Nil() => k2(0, ks2)
      case Cons(head, tail) => {
        let rest = consume!(tail, ks2, return);
        run result = add(head, rest);
        k2(result, ks2)
      }
    }
  }
  let values = produce!(n, ks, return);
  let result = consume!(values, ks, return);
  k(result, ks)
}

// Both recursive computations become one local stack-safe dispatcher, but the
// producer still materializes a list that the sole consumer immediately
// deconstructs. A producer-consumer specialization could fuse the boundary.
/// CALLING_CONVENTIONS

direct
  main = 0 adapter

