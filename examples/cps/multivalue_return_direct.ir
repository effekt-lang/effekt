def main(value, ks, k) {
  def dup(x, ks1, k1) {
    run inc = add(x, 1);
    k1(x, inc, ks1)
  }
  let (a, b) = dup!(value, ks, return);
  run s = add(a, b);
  k(s, ks)
}

// `dup` returns two values through its continuation `k1(x, inc, ks1)`, and the
// caller binds them with `let (a, b) = dup!(...)`. The direct calling convention
// lowers this as an allocation-free jump: each returned value flows into its own
// register (`a_0`, `b_0`) and the body simply falls through the labeled block.
// No tuple is ever constructed.
/// JAVASCRIPT

function main_0(value_0, ks_0, k_0) {
  let a_0 = undefined;
  let b_0 = undefined;
  dup_return_0: {
    const inc_0 = add_0(value_0, 1);
    a_0 = value_0;
    b_0 = inc_0;
  }
  const s_0 = add_0(a_0, b_0);
  return k_0(s_0, ks_0);
}
