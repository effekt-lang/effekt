def main(value, ks, k) {
  def dup(x, ks1, k1) {
    run inc = add(x, 1);
    k1(x, inc, ks1)
  }
  let (a, b) = dup!(value, ks, return);
  k(a, ks)
}

// The second returned value `b` is never used. On the jump path an unused
// result gets neither a register nor an assignment, so only `a_0` survives —
// the returned `inc` value is simply dropped.
/// JAVASCRIPT

function main_0(value_0, ks_0, k_0) {
  function k_1(a_0, b_0, ks_1) {
    return k_0(a_0, ks_0);
  }
  let x_0 = undefined;
  let ks_2 = undefined;
  let k_2 = undefined;
  dup_0: {
    x_0 = value_0;
    ks_2 = ks_0;
    k_2 = k_1;
  }
  const inc_0 = add_0(x_0, 1);
  return k_2(x_0, inc_0, ks_2);
}
