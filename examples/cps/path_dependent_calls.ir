def main(choice, k) {
  def apply(f, x) {
    f(x)
  }
  def inc(x_inc) {
    k(x_inc)
  }
  def dec(x_dec) {
    k(x_dec)
  }
  if (choice) {
    apply(inc, 1)
  } else {
    apply(dec, 0)
  }
}

// The call relation is { (inc, 1), (dec, 0) }, not the cartesian
// approximation { inc, dec } x { 0, 1 }.
/// FLOWS

main
---
x_inc_7 !-> 1
x_dec_9 !-> 0

/// SINK_BLOCKS

def main(choice, k) {
  def apply(f, x) {
    f(x)
  }
  if (choice) {
    def inc(x_inc) {
      k(x_inc)
    }
    apply(inc, 1)
  } else {
    def dec(x_dec) {
      k(x_dec)
    }
    apply(dec, 0)
  }
}

/// DROP_PARAMETERS

def main(choice, k) {
  def apply(f) {
    f()
  }
  if (choice) {
    def inc() {
      k(1)
    }
    apply(inc)
  } else {
    def dec() {
      k(0)
    }
    apply(dec)
  }
}
