type TripleData { Triple(first: Int, second: Int, third: Int) }

def main(i, ks, k) {
  def make3(x, ks1, k1) {
    run inc = add(x, 1);
    run inc2 = add(inc, 1);
    let t = make Triple(x, inc, inc2);
    k1(t, ks1)
  }
  let r = make3!(i, ks, return);
  r match {
    case Triple(a, b, c) => {
      run s = add(a, b);
      run total = add(s, c);
      k(total, ks)
    }
  }
}

// `make3` returns a `Triple` (a single-constructor product), and its only
// caller immediately deconstructs the result. Return raising — argument arity
// raising aimed at the continuation's value argument — drops the allocation:
// the fields flow directly through the continuation `k1(x, inc, inc2, ks1)` and
// the caller binds them with `let (a, b, c) = make3!(...)`, folding the match.
/// ARITY_RAISE

def main(i, ks, k) {
  def make3(x, ks1, k1) {
    run inc = add(x, 1);
    run inc2 = add(inc, 1);
    k1(x, inc, inc2, ks1)
  }
  let (r_0, r_1, r_2) = make3!(i, ks, return);
  run s = add(r_0, r_1);
  run total = add(s, r_2);
  k(total, ks)
}

