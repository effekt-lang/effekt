def main(n, otherKs, ks, k) {
  def sum(i, ks1, k1) {
    run done = eq(i, 0);
    if (done) {
      k1(0, ks1)
    } else {
      run previous = sub(i, 1);
      let result = sum!(previous, ks1, return);
      run total = add(i, result);
      k1(total, ks1)
    }
  }
  if (true) {
    let result = sum!(n, ks, return);
    k(result, ks)
  } else {
    let result = sum!(n, otherKs, return);
    k(result, ks)
  }
}

