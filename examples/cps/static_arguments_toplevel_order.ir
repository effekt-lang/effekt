def main(ks, k) {
  loop(10, ks, k)
}

def loop(i, ks1, k1) {
  run done = eq(i, 0);
  if (done) {
    k1(ks1)
  } else {
    run next = sub(i, 1);
    loop(next, ks1, k1)
  }
}

// Toplevel definitions are mutually visible; in particular, a caller may
// precede the recursive definition that is specialized.

/// STATIC_ARGUMENTS

def main(ks, k) {
  loop(10, ks, k)
}

def loop(i, ks1, k1) {
  def loop_worker(i_1) {
    run done = eq(i_1, 0);
    if (done) {
      k1(ks1)
    } else {
      run next = sub(i_1, 1);
      loop_worker(next)
    }
  }
  loop_worker(i)
}
