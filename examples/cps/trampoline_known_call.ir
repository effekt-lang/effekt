def callee(x, k) {
  k(x)
}
def main(x, k) {
  callee(x, k)
}

// The callee is statically known and the call graph is acyclic.
/// CONTROL_FLOW

ranks
  main = 1
  callee = 0
transfers
  callee -> k: safe [?]
  main -> callee: direct [callee]

/// JAVASCRIPT

function callee_0(x_0, k_0) {
  return k_0(x_0);
}

function main_0(x_1, k_1) {
  return callee_0(x_1, k_1);
}
