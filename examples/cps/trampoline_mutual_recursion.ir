def left(k) {
  right(k)
}
def right(k) {
  left(k)
}
def main(k) {
  left(k)
}

// At least one transfer in the mutually recursive cycle must bounce.
/// CONTROL_FLOW

ranks
  main = 2
  left = 1
  right = 0
transfers
  left -> right: direct [right]
  right -> left: bounce [left]
  main -> left: direct [left]

/// SAFE_ENTRIES

-

/// JAVASCRIPT

function left_0(k_0) {
  return right_0(k_0);
}

function right_0(k_1) {
  return () => left_0(k_1);
}

function main_0(k_2) {
  return left_0(k_2);
}
