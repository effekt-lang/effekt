def invoke(object) {
  object.operation()
}
def loop(flag, k) {
  if (flag) {
    new object : Handler {
      def operation() = { loop(false, k) }
    }
    invoke(object)
  } else {
    k(0)
  }
}
def main(flag, k) {
  loop(flag, k)
}

// The receiver is known compositionally at invoke's call site. The operation
// entry, rather than either surrounding function, breaks the hidden cycle.
/// CONTROL_FLOW

ranks
  main = 2
  operation = 2
  loop = 1
  invoke = 0
transfers
  invoke -> object.operation: safe [?]
  operation -> loop: direct [loop]
  loop -> invoke: direct [invoke]
  loop -> k: safe [?]
  main -> loop: direct [loop]

/// SAFE_ENTRIES

operation operation

/// JAVASCRIPT

function invoke_0(object_0) {
  return object_0.operation_0();
}

function loop_0(flag_0, k_0) {
  loop_0: while (true) {
    if (flag_0) {
      function operation_worker_0() {
        return loop_0(false, backup_k_0);
      }
      const backup_k_0 = k_0;
      const object_1 = { operation_0: () => () => operation_worker_0() };
      return invoke_0(object_1);
    } else {
      return k_0(0);
    }
  }
}

function main_0(flag_1, k_1) {
  return loop_0(flag_1, k_1);
}
