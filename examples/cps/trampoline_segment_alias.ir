def main(p0, ks0, k0) {
  shift(p0) { r, ks, k =>
    let next = k;
    next(1, ks)
  } @ ks0, k0
}

// Aliasing does not lose the fact that this is a segment entry.
/// JAVASCRIPT

function main_0(p_0, ks_0, k_0) {
  {
    const [r_0, ks_1, k_1] = SHIFT(p_0, ks_0, k_0);
    const next_0 = k_1;
    return () => next_0(1, ks_1);
  }
}
