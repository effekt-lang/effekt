def main(p0, ks0, k0) {
  shift(p0) { r, ks, k =>
    run ignored = show(k);
    k(1, ks)
  } @ ks0, k0
}

// A segment entry passed to foreign code is an ordinary function value and
// therefore carries its stack-safe entry convention with it.
/// JAVASCRIPT

function main_0(p_0, ks_0, k_0) {
  const [r_0, ks_1, k_1] = SHIFT(p_0, ks_0, k_0);
  const ignored_0 = show_0((value_0, ks_2) => () => k_1(value_0, ks_2));
  return () => k_1(1, ks_1);
}
