def main(p0, ks0, k0) {
  shift(p0) { r, ks, k =>
    k(1, ks)
  } @ ks0, k0
}

// The continuation returned by shift enters another continuation segment.
// Calling it therefore crosses the trampoline exactly once.
/// JAVASCRIPT

function main_0(p_0, ks_0, k_0) {
  const [r_0, ks_1, k_1] = SHIFT(p_0, ks_0, k_0);
  return () => k_1(1, ks_1);
}
