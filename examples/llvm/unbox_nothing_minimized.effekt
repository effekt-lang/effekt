def ignore[E] { body: => Unit / throw[E] }: Unit = try {
  body()
} with throw[E] { e =>
  ()
}
def default[E, T] { default: => T } { prog: => T / throw[E] }: T =
  try { prog() } with throw[E] { exception => default() }

record WrongFormat()

def main() = ignore[WrongFormat] {
  default[WrongFormat, Int] { do throw(WrongFormat()) } {
    0
  };
  ()
}