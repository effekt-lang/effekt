// the written order of a function type's effects does not change which capture `{A}` means:
// `g` holds `A`'s capability and escapes `A`'s handler (written out of order here, the twin being `effects_in_order`)
interface A { def a(): Int }
interface B { def b(): Int }

def run { f: () => (() => Int at {A}) / { B, A } }: Int =
  try {
    val g = try { f() } with A { def a() = resume(1) }
    g()
  } with B { def b() = resume(2) }

def main() = println(run { () => box { () => do a() } })
