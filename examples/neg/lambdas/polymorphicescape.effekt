interface State[T] {
  def get(): T
  def put[S](n: T, x: S): S
}

def foo() = {
  do get() ++ ""
  do put("", "")
}

def main() = {
  var leak: () => String at io = box { "" };
  try {
    foo();
    foo()
  } with State[String] {
    def get() = resume("")
    def put[S](n, x) = {
      val h = x;
      leak = box { resume(h) } // ERROR
      resume(h)
    }
  }
}
