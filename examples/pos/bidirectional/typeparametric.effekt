extern interface Cap[U, V] =
  js   "number"
  chez "int"
  llvm "%Pos"

extern def cap[U, V]() at {}: Cap[U, V] at {} =
  js   "42"
  chez "42"
  llvm "ret %Pos zeroinitializer"

interface Foo[S] {
  def op[A]() {f: Cap[S, A]}: Cap[S, A] at f / { throw[S] }
}

def main() = {
  def myCap = cap[Int, String]()
  try {
    ignore[Int] {
      val res: Cap[Int, String] at {} = do op() { myCap };
      ()
    }
  } with Foo[Int] {
    def op[B]() = {
      resume { {g: Cap[Int, B]} => do throw(42) }
    }
  }
}
