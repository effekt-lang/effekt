import exception

record RuntimeError(reason: String)

def g[E](x: Int) { act: Int => Int / throw[E] }: Int / throw[E] = act(x)

// `E` is `RuntimeError`, from `act`, and not `MissingValue` from the closer handler
def outer { act: Int => Int / throw[RuntimeError] }: Int / throw[RuntimeError] = {
  with on[MissingValue].panic
  g(1) {act}
}

def main() = {
  val r = try {
    outer { x => do throw(RuntimeError("raised by act")); x }
  } with throw[RuntimeError] { e =>
    println("outer handler: " ++ e.reason); 0
  }
  println(r)
}
