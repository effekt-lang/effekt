// #727: an effect whose type argument, a function type with a type parameter, is written twice
interface Bar {}
interface Foo[T] {
  def foo(): T
}
def foo{block: => Unit / Foo[[A](A) => A at {}]}: Unit = ()
def main(): Unit / {} = {
  foo {
    val f = do foo[[A](A) => A at {}]()
  }
  println("ok")
}
