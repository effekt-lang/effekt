// #727: an effect whose type argument, a function type with two effects, is written twice in different orders
interface Bar {}
interface Baz {}
interface Foo[T] {
  def foo(): T
}
def foo{block: => Unit / Foo[=> Unit / {Bar, Baz} at {}]}: Unit = ()
def main(): Unit / {} = {
  foo {
    val f = do foo[=> Unit / {Baz, Bar} at {}]()
  }
  println("ok")
}
