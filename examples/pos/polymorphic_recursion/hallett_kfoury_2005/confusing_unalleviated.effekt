module examples/pos/polymorphic_recursion/hallett_kfoury_2005/confusing_unalleviated

// Hallett and Kfoury (2005), Section 3.6.1: Confusing -- Unalleviated.
// The type parameter preserves the recursive instantiation pattern; the
// numeric operations in the paper do not depend on its value.
def confusing[A](n: Int, x: A, y: A): Int =
  if (n == 0) n
  else if (n >= 100)
    if (n < 200) n else confusing[A](n / 2, x, y)
  else if (n < 50)
    confusing[Double](n * n, 0.03, 1.0)
  else
    confusing[Int](n * n, 1, 1)

def main() = println(confusing[Int](3, 5, 6))
