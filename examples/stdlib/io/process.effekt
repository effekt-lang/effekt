import process
import stringbuffer
import io/error

def describe(status: ExitStatus): String = status match {
  case Exited(code) => code.show
  case Signaled(signal) => "signal " ++ signal.show
}

def main() = {
  with on[IOError].panic
  val p = spawn("cat", [].fromList, default().onStdout(box { c =>
    println(s"Printed '${c}'")
  }).onStderr(box { c =>
    println(s"Err '${c}'")
  }).withStdin(box { h =>
    h.write("Hello written to stdin");
    h.close()
  })
  )
  println(describe(p))
  val p2 = spawn("echo", ["Hello argument"].fromList, default())
  println(describe(p2))
  ()
}