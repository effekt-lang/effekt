import stream
import map

def main() = {
  val m = map::fromList([(1, 'H'), (2, 'e'), (3, 'l'), (4, 'l'), (5, 'o')], box compareInt)

  for { each(m) } { case (k, v) =>
    println(show(k) ++ ": " ++ show(v) ++ " (" ++ show(v.toInt) ++ ")")
  }

  val newMap = map::collect(box compareInt) { each(m) }
  println(map::internal::prettyPairs(newMap.toList) { n => show(n) } { c => show(c) })

  val hello = string::collect { eachValue(m) }
  println(hello)
}

