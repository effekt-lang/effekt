module custom_map
import list
import io/error
import io/filesystem
import string
import random
import context

def fib(n: Int): Int = n match {
  case 0 => 0
  case 1 => 1
  case _ => fib(n - 1) + fib(n - 2)
}

def map[A, B](list: List[A]){ f: A => B}: List[B] =
  list match{
  case Nil() => Nil()
  case Cons(x, xs) => Cons(f(x), map(xs){f})
}

def plusten(n: Int): Int = n + 10

def readList(file:String): List[Int] = {
  with on[IOError].panic;
  val content = readFile(file)
  val strList = split(content, "")
  val IntList = map(strList){unsafeToInt}
  IntList
}
