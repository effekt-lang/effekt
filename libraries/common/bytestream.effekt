import option
import stringbuffer
import stream
import char
import io/error
import bytearray

// assumes by default:
// BE byteorder, BE bitorder, unsigned

// Wrappers
// --------
/// A with explicit big-endian order
record BE[A](raw: A)
/// A with explicit little-endian order
record LE[A](raw: A)
/// A with explicit width in current unit
/// (bits for bitstreams, bytes for bytestreams)
record OfWidth[A](raw: A, width: Int)
/// explicitly signed A
record Signed[A](raw: A)

/// Bits
type Bit { B0(); B1() }

/// not on Bits
def not(b: Bit): Bit = b match {
  case B0() => B1()
  case B1() => B0()
}

/// Everything that can be spliced into hex/byte stream literals
type HexSplice {
  HexByte(byte: Byte)
  HexChar(char: Char)
  HexString(string: String)
  HexByteArray(array: ByteArray)
  HexLE(value: Int, width: Int)
  HexBE(value: Int, width: Int)
  HexSignedLE(value: Int, width: Int)
  HexSignedBE(value: Int, width: Int)
}

def bytes(b: Byte): HexSplice = HexByte(b)
def bytes(c: Char): HexSplice = HexChar(c)
def bytes(s: String): HexSplice = HexString(s)
def bytes(array: ByteArray): HexSplice = HexByteArray(array)
def bytes(n: Int): HexSplice = HexBE(n, 4)
def bytes(w: LE[Int]): HexSplice = HexLE(w.raw, 4)
def bytes(w: BE[Int]): HexSplice = HexBE(w.raw, 4)
def bytes(w: LE[Signed[Int]]): HexSplice = HexSignedLE(w.raw.raw, 4)
def bytes(w: BE[Signed[Int]]): HexSplice = HexSignedBE(w.raw.raw, 4)
def bytes(w: OfWidth[LE[Int]]): HexSplice = HexLE(w.raw.raw, w.width)
def bytes(w: OfWidth[BE[Int]]): HexSplice = HexBE(w.raw.raw, w.width)
def bytes(w: OfWidth[LE[Signed[Int]]]): HexSplice = HexSignedLE(w.raw.raw.raw, w.width)
def bytes(w: OfWidth[BE[Signed[Int]]]): HexSplice = HexSignedBE(w.raw.raw.raw, w.width)

// Splitting
// ---------

/// emit bytes of the given int as a w bytes in little-endian byte order
def bytesLE(int: Int, w: Int): Unit / emit[Byte] = {
  var c = int
  repeat(w){
    do emit(mod(c, 256).toByte)
    c = c / 256
  }
}

/// emit bytes of the given int as a 4 bytes in little-endian byte order
def bytesLE(int: Int): Unit / emit[Byte] = bytesLE(int, 4)

/// emit bytes of the given int as a w bytes in big-endian byte order
def bytesBE(n: Int, width: Int): Unit / emit[Byte] = {
  var shift = bitwiseShl(width - 1, 3)
  repeat(width) {
    do emit(bitwiseAnd(bitwiseShr(n, shift), 255).toByte)
    shift = shift - 8
  }
}

/// emit bytes of the given int as a 4 bytes in big-endian byte order
def bytesBE(n: Int): Unit / emit[Byte] = bytesBE(n, 4)

/// emit bytes of the given int as width bytes (in 2s-complement) in little-endian byte order
def signedBytesLE(int: Int, width: Int): Unit / emit[Byte] =
  if (int < 0) {
    bytesLE(bitwiseNot(neg(int)) + 1, width)
  } else {
    bytesLE(int, width)
  }
/// emit bytes of the given int as width bytes (in 2s-complement) in big-endian byte order
def signedBytesBE(int: Int, width: Int): Unit / emit[Byte] = {
  if (int < 0) {
    bytesBE(bitwiseNot(neg(int)) + 1, width)
  } else {
    bytesBE(int, width)
  }
}

/// emit bytes of the given int as 4 bytes (in 2s-complement) in little-endian byte order
def signedBytesLE(int: Int): Unit / emit[Byte] = signedBytesLE(int, 4)

/// emit bytes of the given int as 4 bytes (in 2s-complement) in big-endian byte order
def signedBytesBE(int: Int): Unit / emit[Byte] = signedBytesBE(int, 4)



// Splicers
// --------

/// Splicer to emit the bytes in hex notation given, plus eventual splices
/// Ignores whitespace
def hex{ body: => Unit / { write, splice[HexSplice] } }: Unit / emit[Byte] =
  try {
    body()
  } with write { s =>
    feed(s){
      loop {
        attempt {
          val upper: Int = hexDigitValue(do next[Char]())
          val lower: Int = hexDigitValue(do next[Char]())
          do emit[Byte]((16 * upper + lower).toByte)
        } { () }
      }
    }
    resume(())
  } with splice[HexSplice] { spliced =>
    spliced match {
      case HexByte(byte) => do emit(byte)
      case HexChar(char) => do emit(char.toInt.toByte)
      case HexString(string) => feed(string) { loop { do emit(do next[Char]().toInt.toByte) } }
      case HexByteArray(array) => array.foreach { byte => do emit(byte) }
      case HexLE(value, width) => bytesLE(value, width)
      case HexBE(value, width) => bytesBE(value, width)
      case HexSignedLE(value, width) => signedBytesLE(value, width)
      case HexSignedBE(value, width) => signedBytesBE(value, width)
    }
    resume(())
  }

/// convert the given hex notation to an integer (big-endian)
def x{ body: => Unit / { write, splice[HexSplice] } }: Int = {
  var res = 0
  for[Byte]{ hex{body} }{ v => res = res * 256 + v.toInt }
  res
}


// Sub-Byte
// ========

// From/to Bytes
// -------------
/// emit bits of the given Byte as 8 Bits in little-endian bit order
def bitsLE(byte: Byte): Unit / emit[Bit] = {
  val v = byte.toInt
  var mask = 1
  repeat(8){
    bitwiseAnd(v, mask) match {
      case 0 => do emit(B0())  
      case _ => do emit(B1())
    }
    mask = mask * 2
  }
}

/// emit bits of the given Byte as 8 Bits in big-endian bit order
def bitsBE(byte: Byte): Unit / emit[Bit] = {
  val v = byte.toInt
  var mask = 128
  repeat(8){
    bitwiseAnd(v, mask) match {
      case 0 => do emit(B0())  
      case _ => do emit(B1())
    }
    mask = mask / 2
  }
}

/// emit bits of the given Byte as width Bits in little-endian bit order
def bitsLE(v: Int, width: Int): Unit / emit[Bit] = {
  var mask = 1
  repeat(width){
    bitwiseAnd(v, mask) match {
      case 0 => do emit(B0())  
      case _ => do emit(B1())
    }
    mask = mask * 2
  }
}

/// emit bits of the given int as width Bits in big-endian bit order
def bitsBE(v: Int, width: Int): Unit / emit[Bit] = {
  var mask = bitwiseShl(1, width - 1)
  repeat(width){
    bitwiseAnd(v, mask) match {
      case 0 => do emit(B0())  
      case _ => do emit(B1())
    }
    mask = mask / 2
  }
}

/// emit bits of the given int as 32 Bits in big-endian bit order
def bitsBE(int: Int): Unit / emit[Bit] = bitsBE(int, 32)

/// collect bits in big-endian bit order into an Int
def collectBitsBE{ body: => Unit / emit[Bit] }: Int = {
  var res = 0
  try body() with emit[Bit] { b =>
    res = b match {
      case B0() => res * 2
      case B1() => res * 2 + 1
    }
    resume(())
  }
  res
}

/// split emitted bytes and emit the individual bits in big-endian bit order
def ungroupBytesBE{ body: => Unit / emit[Byte] }: Unit / emit[Bit] =
  for[Byte]{body}{ b => bitsBE(b) }

/// streaming negation in 2s-complement for little-endian bitstreams
def twoscomplementLE{ body: => Unit / emit[Bit] }: Unit / emit[Bit] = {
  var carry = true
  try body()
  with emit[Bit] {
    case B0() => if(carry) { do emit(B0()) } else { do emit(B1()) }; resume(())
    case B1() => if(carry) { do emit(B1()); carry = false } else { do emit(B0()) }; resume(())
  }
}  

/// group 8 bits into a byte each, big-endian bit order.
/// NOTE: The remainder is dropped.
def groupBytesBE{ body: => Unit / emit[Bit] }: Unit / emit[Byte] = {
  var next = 0
  var p = 128
  for[Bit]{body}{ b =>
    b match {
      case B0() => ()
      case B1() => next = next + p
    }
    p = p / 2
    if(p == 0) {
      do emit(next.toByte)
      next = 0
      p = 128
    }
  }
}

/// group 8 bits into a byte each, little-endian bit order.
/// NOTE: The remainder is dropped.
def groupBytesLE{ body: => Unit / emit[Bit] }: Unit / emit[Byte] = {
  var next = 0
  var p = 1
  for[Bit]{body}{ b =>
    b match {
      case B0() => ()
      case B1() => next = next + p
    }
    p = p * 2
    if(p == 256) {
      do emit(next.toByte)
      next = 0
      p = 1
    }
  }
}

// Literals/splices
// ----------------
/// Everything that can be spliced into bit stream literals
type BitSplice {
  BitBit(bit: Bit)
  BitByte(byte: Byte)
  BitBytesLE(value: Int)
  BitBytesBE(value: Int)
  BitSignedBytesLE(value: Int)
  BitSignedBytesBE(value: Int)
  BitLE(value: Int, width: Int)
  BitBE(value: Int, width: Int)
  BitSignedLE(value: Int, width: Int)
  BitSignedBE(value: Int, width: Int)
}

def bits(b: Bit): BitSplice = BitBit(b)
def bits(b: Byte): BitSplice = BitByte(b)
def bits(w: LE[Int]): BitSplice = BitBytesLE(w.raw)
def bits(w: BE[Int]): BitSplice = BitBytesBE(w.raw)
def bits(w: LE[Signed[Int]]): BitSplice = BitSignedBytesLE(w.raw.raw)
def bits(w: BE[Signed[Int]]): BitSplice = BitSignedBytesBE(w.raw.raw)
def bits(w: OfWidth[LE[Int]]): BitSplice = BitLE(w.raw.raw, w.width)
def bits(w: OfWidth[BE[Int]]): BitSplice = BitBE(w.raw.raw, w.width)
def bits(w: OfWidth[LE[Signed[Int]]]): BitSplice = BitSignedLE(w.raw.raw.raw, w.width)
def bits(w: OfWidth[BE[Signed[Int]]]): BitSplice = BitSignedBE(w.raw.raw.raw, w.width)

/// Splicer to emit the bits in binary notation given, plus evenutal splices
/// Ignores whitespace
def bit{ body: => Unit / { write, splice[BitSplice] } }: Unit / emit[Bit] =
  try {
    body()
  } with write { s =>
    feed(s){
      loop {
        do next[Char]() match {
          case '0' => do emit(B0())
          case '1' => do emit(B1())
          case _ => ()
        }
      }
    }
    resume(())
  } with splice[BitSplice] { spliced =>
    spliced match {
      case BitBit(bit) => do emit(bit)
      case BitByte(byte) => bitsBE(byte)
      case BitBytesLE(value) => ungroupBytesBE { bytesLE(value) }
      case BitBytesBE(value) => ungroupBytesBE { bytesBE(value) }
      case BitSignedBytesLE(value) => ungroupBytesBE { signedBytesLE(value) }
      case BitSignedBytesBE(value) => ungroupBytesBE { signedBytesBE(value) }
      case BitLE(value, width) => bitsLE(value, width)
      case BitBE(value, width) => bitsBE(value, width)
      case BitSignedLE(value, width) =>
        if (value < 0) {
          twoscomplementLE { bitsLE(0 - value, width) }
        } else {
          bitsLE(value, width)
        }
      case BitSignedBE(value, width) =>
        list::collect[Bit] {
          if (value < 0) {
            twoscomplementLE { bitsLE(0 - value, width) }
          } else {
            bitsLE(value, width)
          }
        }.reverse.each
    }
    resume(())
  }
