module exception

import effekt

// Exceptions
// ==========

effect throw[E](exception: E): Nothing


/**
 * Used as a type for `throw` in functions which expect a value to be present,
 * for example a non-empty container.
 */
record MissingValue(reason: String)

def display(exception: MissingValue): String = exception.reason

/**
 * Used as a type for `throw` in functions where an index can be out of bounds.
 */
record OutOfBounds(index: Int, reason: String)

def display(exception: OutOfBounds): String =
  exception.reason ++ " (index " ++ show(exception.index) ++ ")"

/**
 * Used as a type for `throw` in functions which expect the input
 * to be formatted in a specific way.
 */
record WrongFormat(reason: String)

def display(exception: WrongFormat): String = exception.reason

def wrongFormat(): Nothing / throw[WrongFormat] =
  do throw(WrongFormat("Wrong format."))

def wrongFormat(message: String): Nothing / throw[WrongFormat] =
  do throw(WrongFormat(message))

// Exception Handlers
// ==================

/**
 * Handles exceptions of (static) type E by running the handler on the exception
 */
def catch[E, T] { program: () => T / throw[E] } { handler: E => T } =
  try { program() } with throw[E] { exception => handler(exception) }

/**
 * Converts exceptions of (static) type E to an uncatchable panic that aborts the program
 */
def panicOn[E, T] { program: => T / throw[E] } { ?display: E => String }: T =
  try { program() } with throw[E] { exception => panic(display(exception)) }

/**
 * Reports exceptions of (static) type E to the console
 */
def report[E] { program: => Unit / throw[E] } { ?display: E => String }: Unit =
  try { program() } with throw[E] { exception => println(display(exception)) }

/**
 * Ignores exceptions of (static) type E
 */
def ignore[E] { program: => Unit / throw[E] }: Unit =
  try { program() } with throw[E] { exception => () }

/**
 * Use the default value to handle the exception of type E
 */
def default[E, T] { default: => T } { program: => T / throw[E] }: T =
  try { program() } with throw[E] { exception => default() }

/**
 * Runs the finalizer and rethrows E
 */
def finalize[E, T] { finalizer: => Unit } { program: => T / throw[E] }: T / throw[E] =
  try { val res = program(); finalizer(); res } with throw[E] { exception =>
    finalizer(); do throw(exception)
  }

/**
 * A proxy value to enable partial type applications, such as:
 *
 * ```
 * with on[MissingValue].ignore; ...
 * ```
 */
record on[E]()

def ignore[E](proxy: on[E]) { program: => Unit / throw[E] }: Unit =
  ignore[E] {program}

def default[E, T](proxy: on[E]) { d: => T } { program: => T / throw[E] }: T =
  default[E, T] {d} {program}

def panic[E, T](proxy: on[E]) { program: => T / throw[E] } { ?display: E => String }: T =
  panicOn[E, T] {program} {display}

def report[E](proxy: on[E]) { program: => Unit / throw[E] } { ?display: E => String }: Unit =
  report[E] {program} {display}

def finalize[E, T](proxy: on[E]) { finalizer: => Unit } { program: => T / throw[E] }: T / throw[E] =
  finalize[E, T] {finalizer} {program}