def minimize[A]{ program: () => A / {loss, fork, fail}}: Unit / emit[Weighted[A]] = {
  var weight = 0.0
  var queue = Empty()
  try {
    do emit(Weighted(program(), weight))
  } with fail { () =>
    ()
  } with fork { () => 
    queue = insert(queue, box { resume(false) }, weight)
    resume(true)
  } with loss { (w) => 
    val (Weighted(thread, priority), rest) = exchange(queue, box { resume(()) }, weight + w)
    weight = priority
    queue = rest
    thread()
  }
  while (extract(queue) is Some((Weighted(thread, priority), rest))) {
    weight = priority
    queue = rest
    thread()
  }
}

