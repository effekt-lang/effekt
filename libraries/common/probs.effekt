    with limit[Double](5)
    markovChainSampling {
      val x = sampleGaussian(0.0, 1.0)
      return x
    }
  }{x => println(x)}

  println("\n")

  println("rejection sampling: gaus(-2,5) observed in (unif(0,2))")
  for[Double] {
    do emit(rejectionSampling {
    val x = sampleGaussian(-2.0, 5.0)
    observeUniform(x, 0.0, 2.0)
    return x
    })
  }{x => println(x)}

  println("\n")

  println("rejection sampling: Binomial(0.5, 5) ")
