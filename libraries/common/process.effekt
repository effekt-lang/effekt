module process
import array

extern def exit(errorCode: Int) at io: Nothing =
  js   "(function() { process.exit(${errorCode}) })()"
  llvm """
    %exitCode = trunc i64 ${errorCode} to i32
    call void @exit(i32 %exitCode)
    ret %Pos zeroinitializer
  """
  chez "(exit ${errorCode})"

// Subprocesses
// ------------

/// The standard input of a spawned process.
extern type WritableStream =
  jsNode "stream.Writable"
  llvm "%Pos"

/// How the standard streams of a spawned process are connected to it:
/// each one is either inherited from this process (`None`), or piped to a given callback.
record SpawnOptions(
  stdin: Option[WritableStream => Unit at {io, global}],
  stdout: Option[String => Unit at {io, global}],
  stderr: Option[String => Unit at {io, global}]
)

def SpawnOptions::default(): SpawnOptions = SpawnOptions(None(), None(), None())

/// Pipes the process's standard output to `callback`, chunk by chunk.
def onStdout(opts: SpawnOptions, callback: String => Unit at {io, global}): SpawnOptions =
  SpawnOptions(opts.stdin, Some(internal::chain(opts.stdout, callback)), opts.stderr)

/// Pipes the process's standard error to `callback`, chunk by chunk.
def onStderr(opts: SpawnOptions, callback: String => Unit at {io, global}): SpawnOptions =
  SpawnOptions(opts.stdin, opts.stdout, Some(internal::chain(opts.stderr, callback)))

/// Pipes the process's standard input from `callback`, which runs once the process has started.
def withStdin(opts: SpawnOptions, callback: WritableStream => Unit at {io, global}): SpawnOptions =
  SpawnOptions(Some(internal::chain(opts.stdin, callback)), opts.stdout, opts.stderr)

extern def write(to: WritableStream, s: String) at io: Unit =
  jsNode """${to}.write(${s})"""
  llvm """
    call void @c_write_stream(%Pos ${to}, %Pos ${s})
    ret %Pos zeroinitializer
  """

extern def close(to: WritableStream) at io: Unit =
  jsNode """${to}.end()"""
  llvm """
    call void @c_close_stream(%Pos ${to})
    ret %Pos zeroinitializer
  """

/// Runs `cmd` with `args`, connecting its standard streams as per `options`, returning its exit code.
def spawn(cmd: String, args: Array[String], options: SpawnOptions): Int = {
  val stdin: WritableStream => Unit at {io, global} = options.stdin match {
    case Some(callback) => callback
    case None() => box { _ => () }
  }
  val stdout: String => Unit at {io, global} = options.stdout match {
    case Some(callback) => callback
    case None() => box { _ => () }
  }
  val stderr: String => Unit at {io, global} = options.stderr match {
    case Some(callback) => callback
    case None() => box { _ => () }
  }
  internal::spawn(cmd, args,
    internal::piped(options.stdin), stdin,
    internal::piped(options.stdout), stdout,
    internal::piped(options.stderr), stderr)
}

namespace internal {
  def chain[A](first: Option[A => Unit at {io, global}], then: A => Unit at {io, global}): A => Unit at {io, global} =
    first match {
      case None() => then
      case Some(f) => box { a => f(a); then(a) }
    }

  /// 1 if a stream is piped to a callback, 0 if it is inherited.
  def piped[A](callback: Option[A]): Int = callback match {
    case Some(_) => 1
    case None() => 0
  }

  extern jsNode """
    const { spawn: process$nodeSpawn } = require('node:child_process');

    function process$spawn(cmd, args, pipeStdin, stdin, pipeStdout, stdout, pipeStderr, stderr, callback) {
      const stdio = [pipeStdin ? 'pipe' : 'inherit', pipeStdout ? 'pipe' : 'inherit', pipeStderr ? 'pipe' : 'inherit'];
      const p = process$nodeSpawn(cmd, args, { stdio });
      // Note: Decoded as UTF-8 by the stream itself, so that a character split between two chunks stays whole.
      if (pipeStdout) { p.stdout.setEncoding('utf8'); p.stdout.on('data', chunk => $effekt.runToplevel((ks, k) => stdout(chunk, ks, k))); }
      if (pipeStderr) { p.stderr.setEncoding('utf8'); p.stderr.on('data', chunk => $effekt.runToplevel((ks, k) => stderr(chunk, ks, k))); }
      if (pipeStdin) p.on('spawn', () => $effekt.runToplevel((ks, k) => stdin(p.stdin, ks, k)));
      p.on('close', (exitCode, _signal) => callback(exitCode));
    }
  """

  extern llvm """
    declare void @c_spawn(%Pos, %Pos, %Neg, %Neg, %Neg, %Int, %Int, %Int, %Stack)
    declare void @c_write_stream(%Pos, %Pos)
    declare void @c_close_stream(%Pos)
  """

  extern def spawn(cmd: String, args: Array[String],
      pipeStdin: Int, stdin: WritableStream => Unit at {io, global},
      pipeStdout: Int, stdout: String => Unit at {io, global},
      pipeStderr: Int, stderr: String => Unit at {io, global}) at async: Int =
    jsNode "$effekt.capture(k => process$spawn(${cmd}, ${args}, ${pipeStdin}, ${stdin}, ${pipeStdout}, ${stdout}, ${pipeStderr}, ${stderr}, k))"
    llvm """
      notail call void @c_spawn(%Pos ${cmd}, %Pos ${args}, %Neg ${stdin}, %Neg ${stdout}, %Neg ${stderr}, %Int ${pipeStdin}, %Int ${pipeStdout}, %Int ${pipeStderr}, %Stack %stack)
      ret void
    """
}
