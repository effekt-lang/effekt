module result

import effekt
import option
import exception

/// Represents the result of a potentially failing computation.
/// It is the "reification" of the throw[E] effect.
type Result[A, E] {
  Error(exception: E);
  Success(value: A)
}

/// Represent ("reify") the result of a potentially failing computation.
def result[A, E] { f: => A / throw[E] }: Result[A, E] = try {
  Success(f())
} with throw[E] { exception =>
  Error(exception)
}
def result[A, E](proxy: on[E]) { f: => A / throw[E] }: Result[A, E] = try {
  Success(f())
} with throw[E] { exception =>
  Error(exception)
}

/// Extracts the value of a result, if available
/// Monadic "reflection"
def value[A, E](r: Result[A, E]): A / throw[E] = r match {
  case Success(value) => value
  case Error(exception) => do throw(exception)
}

/// Converts a result to an option forgetting the error details
def toOption[A, E](r: Result[A, E]): Option[A] = r match {
  case Success(value) => Some(value)
  case Error(exception) => None()
}

def isError[A, E](r: Result[A, E]): Bool =
  if (r is Error(_)) true else false

def isSuccess[A, E](r: Result[A, E]): Bool =
  if (r is Success(_)) true else false