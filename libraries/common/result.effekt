module result

import effekt
import option
import exception
import list

/// Represents the result of a potentially failing computation.
/// It is the "reification" of the throw[E] effect.
type Result[R, E] {
  Failure(notice: E);
  Success(result: R)
}

/// Represent ("reify") the result of a potentially failing computation.
def result[A, E] { program: => A / throw[E] }: Result[A, E] =
  try { Success(program()) } with throw[E] { notice => Failure(notice) }

def result[A, E](proxy: on[E]) { program: => A / throw[E] }: Result[A, E] =
  try { Success(program()) } with throw[E] { notice => Failure(notice) }

/// Extracts the value of a result, if available
/// Monadic "reflection"
def value[A, E](r: Result[A, E]): A / throw[E] = r match {
  case Success(a) => a
  case Failure(notice) => do throw(notice)
}

/// Converts a result to an option forgetting the error details
def toOption[A, E](r: Result[A, E]): Option[A] = r match {
  case Success(a) => Some(a)
  case Failure(notice) => None()
}

def isFailure[A, E](r: Result[A, E]): Bool =
  if (r is Failure(_)) true else false

def isSuccess[A, E](r: Result[A, E]): Bool =
  if (r is Success(_)) true else false

/// Runs `action` on `head`, and then on each element of `tail` one by one, returning the result of the first which does not raise,
/// otherwise the exception of the last one.
/// Similar to `default`, but for multiple alternatives, one after another.
def firstSuccess[A, R, E](head: A, tail: List[A]) { action: A => R / throw[E] }: R / throw[E] = {
  def go(candidate: A, rest: List[A]): R = rest match {
    case Nil() => action(candidate)
    case Cons(next, more) =>
      result { action(candidate) } match {
        case Success(value) => value
        case Failure(_) => go(next, more)
      }
  }
  go(head, tail)
}
