/// This file implements the [[Seq]] type as a general purpose functional sequence.
///
/// Implemented as a 2-3 finger tree, it supports
/// - prepend and append in amortized O(1),
/// - concat(m, n) in O(log(min(m, n)))
/// - first and last in amortized O(1)
/// - size in amortized O(1)
///
/// More information on finger trees:
///   https://www.staff.city.ac.uk/~ross/papers/FingerTree.pdf
module seq

/// Sequences of elements
///
/// They are represented as 2-3 finger trees.
type Seq[A] {
  Empty()
  Single(value: A)
  Deep(size: Int, prefix: Digit[A], middle: Seq[Node[A]], suffix: Digit[A])
}

/// Result of splitting a sequence at the front or back.
type View[A] {
  IsEmpty()
  View(element: A, remainder: Seq[A])
}

/// Exception[NoSuchElement] is raised when accessing non-existing elements
/// or splitting empty collections.
record NoSuchElement()


record IndexOutOfBounds()



// Implementation
// ==============
// Internal implementation note:
//   we use the following abbreviations:
//   - s: suffix
//   - p: prefix
//   - v: value
//   - n: node
//   - m: middle (spine)
//   - a,b,c,d: elements of a digit in this order
//
// we do not abbreviate:
//   - size


// Internal Types
// --------------

/// Internal grouping of 1-4 elements
///
/// It is called digit since Okasaki (1998) calls finger trees "numerical operations".
type Digit[A] {
  One(value: A)
  Two(first: A, second: A)
  Three(first: A, second: A, third: A)
  Four(first: A, second: A, third: A, fourth: A)
}

/// Internal representation of a 2-3 tree
type Node[A] {
  Node2(size: Int, first: A, second: A)
  Node3(size: Int, first: A, second: A, third: A)
}



// Measure
// -------

def size[A](node: Digit[A]): Int = node match {
  case One(_) => 1
  case Two(_, _) => 2
  case Three(_, _, _) => 3
  case Four(_, _, _, _) => 4
}

def size[A](node: Node[A]): Int = node match {
  case Node2(size, _, _) => size
  case Node3(size, _, _, _) => size
}

def sizeDeep[A](node: Digit[Node[A]]): Int = node match {
  case One(a) => a.size
  case Two(a, b) => a.size + b.size
  case Three(a, b, c) => a.size + b.size + c.size
  case Four(a, b, c, d) => a.size + b.size + c.size + d.size
}

def sizeNodes[A](tree: Seq[Node[A]]): Int = tree match {
  case Empty() => 0
  case Single(value) => value.size
  case Deep(size, _, _, _) => size
}

/// The size of the given sequence
def size[A](seq: Seq[A]): Int = seq match {
  case Empty() => 0
  case Single(value) => 1
  case Deep(size, _, _, _) => size
}


// Internal smart constructors
// ---------------------------

def deepNodes[A](prefix: Digit[Node[A]], middle: Seq[Node[Node[A]]], suffix: Digit[Node[A]]): Seq[Node[A]] =
  Deep(prefix.sizeDeep + middle.sizeNodes + suffix.sizeDeep, prefix, middle, suffix)

def deep[A](prefix: Digit[A], middle: Seq[Node[A]], suffix: Digit[A]): Seq[A] =
  Deep(prefix.size + middle.sizeNodes + suffix.size, prefix, middle, suffix)

def node2[A](first: Node[A], second: Node[A]): Node[Node[A]] =
  Node2(first.size + second.size, first, second)

def node3[A](first: Node[A], second: Node[A], third: Node[A]): Node[Node[A]] =
  Node3(first.size + second.size + third.size, first, second, third)


// Adding an element to the left
// -----------------------------

def consNodes[A](head: Node[A], tail: Seq[Node[A]]): Seq[Node[A]] = tail match {
  case Empty()                          => Single(head)
  case Single(b)                        => Deep(head.size + b.size, One(head), Empty(), One(b))
  case Deep(size, One(b), m, s)         => Deep(size + head.size, Two(head, b), m, s)
  case Deep(size, Two(b, c), m, s)      => Deep(size + head.size, Three(head, b, c), m, s)
  case Deep(size, Three(b, c, d), m, s) => Deep(size + head.size, Four(head, b, c, d), m, s)
  case Deep(size, Four(b, c, d, e), m, s) =>
    Deep(size + head.size, Two(head, b), consNodes[Node[A]](node3(c, d, e), m), s)
}

def cons[A](head: A, tail: Seq[A]): Seq[A] = tail match {
  case Empty()                            => Single(head)
  case Single(b)                          => Deep(2, One(head), Empty(), One(b))
  case Deep(size, One(b), m, s)           => Deep(size + 1, Two(head, b), m, s)
  case Deep(size, Two(b, c), m, s)        => Deep(size + 1, Three(head, b, c), m, s)
  case Deep(size, Three(b, c, d), m, s)   => Deep(size + 1, Four(head, b, c, d), m, s)
  case Deep(size, Four(b, c, d, e), m, s) =>
    Deep(size + 1, Two(head, b), consNodes(Node3(3, c, d, e), m), s)
}


// Adding an element to the right
// ------------------------------

def consNodesRight[A](init: Seq[Node[A]], last: Node[A]): Seq[Node[A]] = init match {
  case Empty()                          => Single(last)
  case Single(b)                        => Deep(b.size + last.size, One(b), Empty(), One(last))
  case Deep(size, p, m, One(b))         => Deep(size + last.size, p, m, Two(b, last))
  case Deep(size, p, m, Two(b, c))      => Deep(size + last.size, p, m, Three(b, c, last))
  case Deep(size, p, m, Three(b, c, d)) => Deep(size + last.size, p, m, Four(b, c, d, last))
  case Deep(size, p, m, Four(b, c, d, e)) =>
    Deep(size + last.size, p, consNodesRight[Node[A]](m, node3(b, c, d)), Two(e, last))
}

def consRight[A](init: Seq[A], last: A): Seq[A] = init match {
  case Empty()                          => Single(last)
  case Single(b)                        => Deep(2, One(b), Empty(), One(last))
  case Deep(size, p, m, One(b))         => Deep(size + 1, p, m, Two(b, last))
  case Deep(size, p, m, Two(b, c))      => Deep(size + 1, p, m, Three(b, c, last))
  case Deep(size, p, m, Three(b, c, d)) => Deep(size + 1, p, m, Four(b, c, d, last))
  case Deep(size, p, m, Four(b, c, d, e)) =>
    Deep(size + 1, p, consNodesRight(m, Node3(3, b, c, d)), Two(e, last))
}


// Splitting the sequence on the left
// ----------------------------------

def unconsNodes[A](seq: Seq[Node[A]]): View[Node[A]] = seq match {
  case Empty()   => IsEmpty()
  case Single(v) => View(v, Empty())
  // TODO this is a tail-call-modulo-context
  case Deep(size, One(a), m, s) => View(a, unconsNodes[Node[A]](m) match {
    case IsEmpty() => s.toSeqNodes
    case View(b, m2) => Deep(size - a.size, b.toDigit, m2, s)
  })
  case Deep(size, Two(a, b), m, s)        => View(a, Deep(size - a.size, One(b), m, s))
  case Deep(size, Three(a, b, c), m, s)   => View(a, Deep(size - a.size, Two(b, c), m, s))
  case Deep(size, Four(a, b, c, d), m, s) => View(a, Deep(size - a.size, Three(b, c, d), m, s))
}

// this could be called "uncons", "first", "front", "head", "popFront", "start", "popStart"
def uncons[A](seq: Seq[A]): View[A] = seq match {
  case Empty()   => IsEmpty()
  case Single(v) => View(v, Empty())
  case Deep(size, One(a), m, s) => View(a, unconsNodes(m) match {
    case IsEmpty() => s.toSeq
    case View(b, m2) => Deep(size - 1, b.toDigit, m2, s)
  })
  case Deep(size, Two(a, b), m, s) => View(a, Deep(size - 1, One(b), m, s))
  case Deep(size, Three(a, b, c), m, s) => View(a, Deep(size - 1, Two(b, c), m, s))
  case Deep(size, Four(a, b, c, d), m, s) => View(a, Deep(size - 1, Three(b, c, d), m, s))
}

def head[A](seq: Seq[A]): A / Exception[NoSuchElement] = seq.uncons match {
  case IsEmpty() => raise(NoSuchElement(), "Calling `head` on empty sequence.")
  case View(element, _) => element
}

def tail[A](seq: Seq[A]): Seq[A] / Exception[NoSuchElement] = seq.uncons match {
  case IsEmpty() => raise(NoSuchElement(), "Calling `tail` on empty sequence.")
  case View(element, rest) => rest
}


// Splitting the sequence on the right
// -----------------------------------

def unconsRightNodes[A](seq: Seq[Node[A]]): View[Node[A]] = seq match {
  case Empty()   => IsEmpty()
  case Single(v) => View(v, Empty())
  // TODO this is a tail-call-modulo-context
  case Deep(size, p, m, One(a)) => View(a, unconsRightNodes[Node[A]](m) match {
    case IsEmpty() => p.toSeqNodes
    case View(b, m2) => Deep(size - a.size, p, m2, b.toDigit)
  })
  case Deep(size, p, m, Two(a, b))        => View(b, Deep(size - b.size, p, m, One(a)))
  case Deep(size, p, m, Three(a, b, c))   => View(c, Deep(size - c.size, p, m, Two(a, b)))
  case Deep(size, p, m, Four(a, b, c, d)) => View(d, Deep(size - d.size, p, m, Three(a, b, c)))
}

// this could be called "uncons", "first", "front", "head", "popFront", "start", "popStart"
def unconsRight[A](seq: Seq[A]): View[A] = seq match {
  case Empty()   => IsEmpty()
  case Single(v) => View(v, Empty())
  case Deep(size, p, m, One(a)) => View(a, unconsRightNodes(m) match {
    case IsEmpty() => p.toSeq
    case View(b, m2) => Deep(size - 1, p, m2, b.toDigit)
  })
  case Deep(size, p, m, Two(a, b))        => View(b, Deep(size - 1, p, m, One(a)))
  case Deep(size, p, m, Three(a, b, c))   => View(c, Deep(size - 1, p, m, Two(a, b)))
  case Deep(size, p, m, Four(a, b, c, d)) => View(d, Deep(size - 1, p, m, Three(a, b, c)))
}


// Concatenating Sequences
// -----------------------

def concatNodes[A](first: Seq[Node[A]], middle: List[Node[A]], second: Seq[Node[A]]): Seq[Node[A]] = {

  // can we get rid of the list?

  def prepend(nodes: List[Node[A]], tree: Seq[Node[A]]): Seq[Node[A]] = nodes match {
    case Nil() => tree
    case Cons(head, tail) => consNodes(head, prepend(tail, tree))
  }

  def append(tree: Seq[Node[A]], nodes: List[Node[A]]): Seq[Node[A]] = nodes match {
    case Nil() => tree
    case Cons(head, tail) => append(consNodesRight(tree, head), tail)
  }

  def consDigit(digit: Digit[Node[A]], tree: Seq[Node[A]]): Seq[Node[A]] = digit match {
    case One(a) => consNodes(a, tree)
    case Two(a, b) => consNodes(a, consNodes(b, tree))
    case Three(a, b, c) => consNodes(a, consNodes(b, consNodes(c, tree)))
    case Four(a, b, c, d) => consNodes(a, consNodes(b, consNodes(c, consNodes(d, tree))))
  }

  def toList(digit: Digit[Node[A]]): List[Node[A]] = digit match {
    case One(a) => Cons(a, Nil())
    case Two(a, b) => Cons(a, Cons(b, Nil()))
    case Three(a, b, c) => Cons(a, Cons(b, Cons(c, Nil())))
    case Four(a, b, c, d) => Cons(a, Cons(b, Cons(c, Cons(d, Nil()))))
  }

  def rebalance(nodes: List[Node[A]]): List[Node[Node[A]]] = nodes match {
    case Cons(a, Cons(b, Nil())) => Cons(node2(a, b), Nil())
    case Cons(a, Cons(b, Cons(c, Nil()))) => Cons(node3(a, b, c), Nil())
    case Cons(a, Cons(b, Cons(c, Cons(d, Nil())))) => Cons(node2(a, b), Cons(node2(c, d), Nil()))
    case Cons(a, Cons(b, Cons(c, rest))) => Cons(node3(a, b, c), rebalance(rest))
    case _ => <>
  }

  (first, second) match {
    case (Empty(), s)      => prepend(middle, s)
    case (p, Empty())      => append(p, middle)
    case (Single(v), s)    => consNodes(v, prepend(middle, s))
    case (p, Single(v))    => consNodesRight(append(p, middle), v)
    case (Deep(size1, p1, m1, s1), Deep(size2, p2, m2, s2)) =>
      val list = s1.toList.append(middle).append(p2.toList)
      Deep(size1 + size2, p1, concatNodes[Node[A]](m1, rebalance(list), m2), s2)
  }
}

def concat[A](first: Seq[A], second: Seq[A]): Seq[A] = {
  def rebalance(t: List[A]): List[Node[A]] = t match {
    case Cons(a, Cons(b, Nil())) => Cons(Node2(2, a, b), Nil())
    case Cons(a, Cons(b, Cons(c, Nil()))) => Cons(Node3(3, a, b, c), Nil())
    case Cons(a, Cons(b, Cons(c, Cons(d, Nil())))) => Cons(Node2(2, a, b), Cons(Node2(2, c, d), Nil()))
    case Cons(a, Cons(b, Cons(c, rest))) => Cons(Node3(3, a, b, c), rebalance(rest))
    case _ => <>
  }

  (first, second) match {
    case (Empty(), other) => other
    case (other, Empty()) => other
    case (Single(v), other) => cons(v, other)
    case (other, Single(v)) => consRight(other, v)
    case (Deep(size1, p1, m1, s1), Deep(size2, p2, m2, s2)) =>
      Deep(size1 + size2, p1, concatNodes(m1, rebalance(s1.toList.append(p2.toList)), m2), s2)
  }
}


// Predicates
// ----------

def isEmpty[A](seq: Seq[A]): Bool = seq match {
  case Empty() => true
  case _ => false
}

def nonEmpty[A](seq: Seq[A]): Bool = seq match {
  case Empty() => false
  case _ => true
}

def reverseNode[A](node: Node[A]) { reverseElement: A => A }: Node[A] = node match {
  case Node2(size, a, b) => Node2(size, reverseElement(b), reverseElement(a))
  case Node3(size, a, b, c) => Node3(size, reverseElement(c), reverseElement(b), reverseElement(a))
}

def reverseDigit[A](digit: Digit[A]) { reverseElement: A => A }: Digit[A] = digit match {
  case One(a) => One(reverseElement(a))
  case Two(a, b) => Two(reverseElement(b), reverseElement(a))
  case Three(a, b, c) => Three(reverseElement(c), reverseElement(b), reverseElement(a))
  case Four(a, b, c, d) => Four(reverseElement(d), reverseElement(c), reverseElement(b), reverseElement(a))
}

def reverseWith[A](seq: Seq[A]) { reverseElement: A => A }: Seq[A] = seq match {
  case Empty() => Empty()
  case Single(value) => Single(reverseElement(value))
  case Deep(size, p, m, s) => Deep(
    size,
    reverseDigit(s) { reverseElement },
    reverseWith[Node[A]](m) { node => reverseNode(node) { reverseElement } },
    reverseDigit(p) { reverseElement }
  )
}

def reverse[A](seq: Seq[A]): Seq[A] = reverseWith(seq) { value => value }


/// Random access
def measureDigit[A](digit: Digit[A]) { measure: A => Int }: Int = digit match {
  case One(a) => measure(a)
  case Two(a, b) => measure(a) + measure(b)
  case Three(a, b, c) => measure(a) + measure(b) + measure(c)
  case Four(a, b, c, d) => measure(a) + measure(b) + measure(c) + measure(d)
}

def indexNode[A, R](node: Node[A], index: Int)
  { measure: A => Int }
  { select: (A, Int) => R }: R = node match {
  case Node2(_, a, b) =>
    val asize = measure(a)
    if (index < asize) select(a, index) else select(b, index - asize)
  case Node3(_, a, b, c) =>
    val asize = measure(a)
    if (index < asize) select(a, index) else {
      val bsize = asize + measure(b)
      if (index < bsize) select(b, index - asize) else select(c, index - bsize)
    }
}

def indexDigit[A, R](digit: Digit[A], index: Int)
  { measure: A => Int }
  { select: (A, Int) => R }: R = digit match {
  case One(a) => select(a, index)
  case Two(a, b) =>
    val asize = measure(a)
    if (index < asize) select(a, index) else select(b, index - asize)
  case Three(a, b, c) =>
    val asize = measure(a)
    if (index < asize) select(a, index) else {
      val bsize = asize + measure(b)
      if (index < bsize) select(b, index - asize) else select(c, index - bsize)
    }
  case Four(a, b, c, d) =>
    val asize = measure(a)
    if (index < asize) select(a, index) else {
      val bsize = asize + measure(b)
      if (index < bsize) select(b, index - asize) else {
        val csize = bsize + measure(c)
        if (index < csize) select(c, index - bsize) else select(d, index - csize)
      }
    }
}

def indexWith[A, R](seq: Seq[A], index: Int)
  { measure: A => Int }
  { select: (A, Int) => R }: R = seq match {
  case Empty() => <{ "Cannot happen!" }>
  case Single(value) => select(value, index)
  case Deep(_, p, m, s) =>
    val psize = measureDigit(p) { measure }
    if (index < psize) indexDigit(p, index) { measure } { select } else {
      val msize = psize + m.sizeNodes
      if (index < msize) {
        indexWith[Node[A], R](m, index - psize)
          { node => node.size }
          { (node, offset) => indexNode(node, offset) { measure } { select } }
      } else indexDigit(s, index - msize) { measure } { select }
    }
}

def index[A](seq: Seq[A], index: Int): A / Exception[NoSuchElement] =
  if (index < 0 || index >= seq.size) raise(NoSuchElement(), "...")
  else indexWith[A, A](seq, index) { _ => 1 } { (value, _) => value }

/// Random access
def updateNode[A](node: Node[A], index: Int)
  { measure: A => Int }
  { updateElement: (A, Int) => A }: Node[A] = node match {
  case Node2(size, a, b) =>
    val asize = measure(a)
    if (index < asize) Node2(size, updateElement(a, index), b)
    else Node2(size, a, updateElement(b, index - asize))
  case Node3(size, a, b, c) =>
    val asize = measure(a)
    if (index < asize) Node3(size, updateElement(a, index), b, c) else {
      val bsize = asize + measure(b)
      if (index < bsize) Node3(size, a, updateElement(b, index - asize), c)
      else Node3(size, a, b, updateElement(c, index - bsize))
    }
}

def updateDigit[A](digit: Digit[A], index: Int)
  { measure: A => Int }
  { updateElement: (A, Int) => A }: Digit[A] = digit match {
  case One(a) => One(updateElement(a, index))
  case Two(a, b) =>
    val asize = measure(a)
    if (index < asize) Two(updateElement(a, index), b)
    else Two(a, updateElement(b, index - asize))
  case Three(a, b, c) =>
    val asize = measure(a)
    if (index < asize) Three(updateElement(a, index), b, c) else {
      val bsize = asize + measure(b)
      if (index < bsize) Three(a, updateElement(b, index - asize), c)
      else Three(a, b, updateElement(c, index - bsize))
    }
  case Four(a, b, c, d) =>
    val asize = measure(a)
    if (index < asize) Four(updateElement(a, index), b, c, d) else {
      val bsize = asize + measure(b)
      if (index < bsize) Four(a, updateElement(b, index - asize), c, d) else {
        val csize = bsize + measure(c)
        if (index < csize) Four(a, b, updateElement(c, index - bsize), d)
        else Four(a, b, c, updateElement(d, index - csize))
      }
    }
}

def updateWith[A](seq: Seq[A], index: Int)
  { measure: A => Int }
  { updateElement: (A, Int) => A }: Seq[A] = seq match {
  case Empty() => <{ "Cannot happen!" }>
  case Single(value) => Single(updateElement(value, index))
  case Deep(size, p, m, s) =>
    val psize = measureDigit(p) { measure }
    if (index < psize) Deep(size, updateDigit(p, index) { measure } { updateElement }, m, s) else {
      val msize = psize + m.sizeNodes
      if (index < msize) Deep(size, p,
        updateWith[Node[A]](m, index - psize)
          { node => node.size }
          { (node, offset) => updateNode(node, offset) { measure } { updateElement } },
        s)
      else Deep(size, p, m, updateDigit(s, index - msize) { measure } { updateElement })
    }
}

def update[A](seq: Seq[A], index: Int, value: A): Seq[A] / Exception[NoSuchElement] =
  if (index < 0 || index >= seq.size) raise(NoSuchElement(), "...")
  else updateWith(seq, index) { _ => 1 } { (_, _) => value }


def eachDigit[A](digit: Digit[A]) { consume: A => Unit }: Unit = digit match {
  case One(a) => consume(a)
  case Two(a, b) => consume(a); consume(b)
  case Three(a, b, c) => consume(a); consume(b); consume(c)
  case Four(a, b, c, d) => consume(a); consume(b); consume(c); consume(d)
}

def eachNode[A](node: Node[A]) { consume: A => Unit }: Unit = node match {
  case Node2(_, a, b) => consume(a); consume(b)
  case Node3(_, a, b, c) => consume(a); consume(b); consume(c)
}

def each[A](seq: Seq[A]) { consume: (A) => Unit }: Unit = seq match {
  case Empty() => ()
  case Single(v) => consume(v)
  case Deep(_, p, m, s) =>
    eachDigit(p) { consume }
    each[Node[A]](m) { node => eachNode(node) { consume } }
    eachDigit(s) { consume }
}

def each[A](seq: Seq[A]) { f: (A) {Label} => Unit }: Unit = try {
  seq.each { (el) =>
    try { f(el) {inner} } with inner: Label {
      def break() = outer.break()
      def continue() = ()
    }
  }
} with outer: Label {
  def break() = ()
  def continue() = ()
}

def eachDigitReverse[A](digit: Digit[A]) { consume: A => Unit }: Unit = digit match {
  case One(a) => consume(a)
  case Two(a, b) => consume(b); consume(a)
  case Three(a, b, c) => consume(c); consume(b); consume(a)
  case Four(a, b, c, d) => consume(d); consume(c); consume(b); consume(a)
}

def eachNodeReverse[A](node: Node[A]) { consume: A => Unit }: Unit = node match {
  case Node2(_, a, b) => consume(b); consume(a)
  case Node3(_, a, b, c) => consume(c); consume(b); consume(a)
}

def eachReverse[A](seq: Seq[A]) { consume: A => Unit }: Unit = seq match {
  case Empty() => ()
  case Single(v) => consume(v)
  case Deep(_, p, m, s) =>
    eachDigitReverse(s) { consume }
    eachReverse[Node[A]](m) { node => eachNodeReverse(node) { consume } }
    eachDigitReverse(p) { consume }
}

def eachReverse[A](seq: Seq[A]) { f: (A) {Label} => Unit }: Unit = try {
  seq.eachReverse { (el) =>
    try { f(el) {inner} } with inner: Label {
      def break() = outer.break()
      def continue() = ()
    }
  }
} with outer: Label {
  def break() = ()
  def continue() = ()
}

def toList[A](seq: Seq[A]): List[A] = {
  var list: List[A] = Nil()
  seq.eachReverse { el => list = Cons(el, list) }
  list
}

def toSeq[A](l: List[A]): Seq[A] = {
  def go(l: List[A], acc: Seq[A]): Seq[A] = l match {
    case Nil() => acc
    case Cons(head, tail) => go(tail, consRight(acc, head))
  }
  go(l, Empty())
}


record Split[A, R](prefix: R, element: A, suffix: R)

def splitDigit[A](digit: Digit[A], index: Int)
  { measure: A => Int }: Split[A, List[A]] = digit match {
  case One(a) => Split([], a, [])
  case Two(a, b) =>
    if (index < measure(a)) Split([], a, [b]) else Split([a], b, [])
  case Three(a, b, c) =>
    val asize = measure(a)
    if (index < asize) Split([], a, [b, c])
    else if (index < asize + measure(b)) Split([a], b, [c])
    else Split([a, b], c, [])
  case Four(a, b, c, d) =>
    val asize = measure(a)
    val bsize = asize + measure(b)
    val csize = bsize + measure(c)
    if (index < asize) Split([], a, [b, c, d])
    else if (index < bsize) Split([a], b, [c, d])
    else if (index < csize) Split([a, b], c, [d])
    else Split([a, b, c], d, [])
}

def leftNodes[A](p: List[Node[A]], m: Seq[Node[Node[A]]], s: Digit[Node[A]]): Seq[Node[A]] = p match {
  case Nil() => unconsNodes[Node[A]](m) match {
    case IsEmpty() => s.toSeqNodes
    case View(a, m2) => deepNodes(a.toDigit, m2, s)
  }
  case _ => deepNodes(p.toDigit, m, s)
}

def rightNodes[A](p: Digit[Node[A]], m: Seq[Node[Node[A]]], s: List[Node[A]]): Seq[Node[A]] = s match {
  case Nil() => unconsRightNodes[Node[A]](m) match {
    case IsEmpty() => p.toSeqNodes
    case View(a, m2) => deepNodes(p, m2, a.toDigit)
  }
  case _ => deepNodes(p, m, s.toDigit)
}

def splitNodes[A](tree: Seq[Node[A]], index: Int): Split[Node[A], Seq[Node[A]]] = tree match {
  case Empty() => <{ "Cannot happen!" }>
  case Single(value) => Split(Empty(), value, Empty())
  case Deep(_, p, m, s) =>
    val psize = p.sizeDeep
    if (index < psize) {
      val Split(pp, v, ps) = splitDigit(p, index) { node => node.size }
      Split(pp.toSeqNodes, v, leftNodes(ps, m, s))
    } else {
      val msize = psize + m.sizeNodes
      if (index < msize) {
        val Split(mp, v, ms) = splitNodes[Node[A]](m, index - psize)
        val mpsize = psize + mp.sizeNodes
        val Split(vp, w, vs) = splitDigit(v.toDigit, index - mpsize) { node => node.size }
        Split(rightNodes(p, mp, vp), w, leftNodes(vs, ms, s))
      } else {
        val Split(sp, v, ss) = splitDigit(s, index - msize) { node => node.size }
        Split(rightNodes(p, m, sp), v, ss.toSeqNodes)
      }
    }
}

def splitAt[A](seq: Seq[A], index: Int): (Seq[A], Seq[A]) / Exception[IndexOutOfBounds] = {
  def left(p: List[A], m: Seq[Node[A]], s: Digit[A]): Seq[A] = p match {
    case Nil() => unconsNodes(m) match {
      case IsEmpty() => s.toSeq
      case View(a, m2) => deep(a.toDigit, m2, s)
    }
    case _ => deep(p.toDigit, m, s)
  }

  def right(p: Digit[A], m: Seq[Node[A]], s: List[A]): Seq[A] = s match {
    case Nil() => unconsRightNodes(m) match {
      case IsEmpty() => p.toSeq
      case View(a, m2) => deep(p, m2, a.toDigit)
    }
    case _ => deep(p, m, s.toDigit)
  }

  if (index < 0) {
    do raise(IndexOutOfBounds(), "...")
  } else if (index >= seq.size) {
    (seq, Empty())
  } else seq match {
    case Empty() => (Empty(), Empty())
    case Single(_) => (Empty(), seq)
    case Deep(_, p, m, s) =>
      val psize = p.size
      if (index < psize) {
        val Split(pp, v, ps) = splitDigit(p, index) { _ => 1 }
        (toSeq(pp), left(Cons(v, ps), m, s))
      } else {
        val msize = psize + m.sizeNodes
        if (index < msize) {
          val Split(mp, v, ms) = splitNodes(m, index - psize)
          val mpsize = psize + mp.sizeNodes
          val Split(vp, w, vs) = splitDigit(v.toDigit, index - mpsize) { _ => 1 }
          (right(p, mp, vp), left(Cons(w, vs), ms, s))
        } else {
          val Split(sp, v, ss) = splitDigit(s, index - msize) { _ => 1 }
          (right(p, m, sp), Cons(v, ss).toSeq)
        }
      }
  }
}


def insert[A](seq: Seq[A], value: A, index: Int): Seq[A] / Exception[IndexOutOfBounds] =
  splitAt(seq, index) match {
    case (prefix, suffix) => prefix.concat(cons(value, suffix))
  }



// Internal conversions
// --------------------

def toSeqNodes[A](digit: Digit[Node[A]]): Seq[Node[A]] = digit match {
  case One(a) => Single(a)
  case Two(a, b) => deepNodes(One(a), Empty(), One(b))
  case Three(a, b, c) => deepNodes(Two(a, b), Empty(), One(c))
  case Four(a, b, c, d) => deepNodes(Three(a, b, c), Empty(), One(d))
}

def toSeqNodes[A](digit: List[Node[A]]): Seq[Node[A]] = digit match {
  case Nil() => Empty()
  case Cons(a, Nil()) => Single(a)
  case Cons(a, Cons(b, Nil())) => deepNodes(One(a), Empty(), One(b))
  case Cons(a, Cons(b, Cons(c, Nil()))) => deepNodes(Two(a, b), Empty(), One(c))
  case Cons(a, Cons(b, Cons(c, Cons(d, Nil())))) => deepNodes(Three(a, b, c), Empty(), One(d))
  case _ => <>
}

def toSeq[A](d: Digit[A]): Seq[A] =  d match {
  case One(a) => Single(a)
  case Two(a, b) => Deep(2, One(a), Empty(), One(b))
  case Three(a, b, c) => Deep(3, Two(a, b), Empty(), One(c))
  case Four(a, b, c, d) => Deep(4, Three(a, b, c), Empty(), One(d))
}

def toDigit[A](n: Node[A]): Digit[A] = n match {
  case Node2(_, a, b) => Two(a, b)
  case Node3(_, a, b, c) => Three(a, b, c)
}

def toDigit[A](n: List[A]): Digit[A] = n match {
  case Cons(a, Nil()) => One(a)
  case Cons(a, Cons(b, Nil())) => Two(a, b)
  case Cons(a, Cons(b, Cons(c, Nil()))) => Three(a, b, c)
  case Cons(a, Cons(b, Cons(c, Cons(d, Nil())))) => Four(a, b, c, d)
  case _ => <{ "Should not happen" }>
}

def toList[A](digit: Digit[A]): List[A] = digit match {
  case One(a) => Cons(a, Nil())
  case Two(a, b) => Cons(a, Cons(b, Nil()))
  case Three(a, b, c) => Cons(a, Cons(b, Cons(c, Nil())))
  case Four(a, b, c, d) => Cons(a, Cons(b, Cons(c, Cons(d, Nil()))))
}

def map[A, B](seq: Seq[A]) { f: A => B }: Seq[B] = {
  var result: Seq[B] = Empty()
  seq.each { a => result = result.consRight(f(a)) }
  result
}

def map[A, B](seq: Seq[A]) { f: (A) {Label} => B }: Seq[B] = {
  var result: Seq[B] = Empty()
  seq.each { (a) {label} => result = result.consRight(f(a) {label}) }
  result
}


