  // ************************
  // Bidirectional actors
  // ************************
  
  val a1 = newActor("A1")
  val a2 = newActor("A2")

  // with emit { i => ... }
  def a1HandleEmit(i: Int) = {
    println("A1 got " ++ i.show)
  }
  val t1 = actorThreadStart(a1, box a1HandleEmit, [a2]) { 
    a1.sendEmit(1, a2) // do emit(1)    (with A2 as handler)
    a1.sendEmit(2, a2) // do emit(2)
    a1.sendEmit(3, a2) // do emit(3)
    println("A1 done")
  }
  // with emit { i => ... }
  def a2HandleEmit(i: Int) = {
    println("A2 got " ++ i.show)
    a2.sendEmit(i + 3, a1) // with emit { i => do emit(i + 3) }     (with A1 as handler)
    a2.sendEmit(42, a1)
  }
  val t2 = actorThreadStart(a2, box a2HandleEmit, [a1]) {
    println("A2 done")
  }

  joinThread(t1)
  joinThread(t2)
}
