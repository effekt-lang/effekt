extern llvm """
    declare %Pos @c_queue_new()
    declare %Pos @c_queue_empty(%Pos)
    declare %Pos @c_queue_full(%Pos)
    declare %Pos @c_queue_unsafeEnqueue(%Pos, %Pos)
    declare %Pos @c_queue_unsafeDequeue(%Pos)
    declare %Pos @c_queue_unsafePeek(%Pos)
    declare %Pos @c_queue_unsafePop(%Pos)

    declare %Pos @c_queue_send_emit(%Pos, %Int, %Pos, %Stack)
    declare %Pos @c_queue_send_resume(%Pos, %Stack)
    declare %Pos @c_queue_resume(%Pos)
    declare %Pos @c_message_new_emit(%Int, %Stack)
    declare %Pos @c_message_value(%Pos)
    declare %Stack @c_message_continuation(%Pos)

    declare %Pos @c_actor_new(%Pos)
    declare %Pos @c_actor_start(%Pos, %Stack)
    declare void @c_actor_inspect_queue(%Pos)
    declare void @c_inspect_rc(%Pos)
    declare void @c_actor_share(%Pos)
    declare void @c_actor_erase(%Pos)
    declare void @c_thread_start(%Neg)
    declare void @c_thread_join(%Pos)

    declare void @sleep(i64)

    define void @thread_wrapper(ptr %neg) {
      %functionPointerPointer = getelementptr ptr, ptr %neg, i64 0
      %object = getelementptr ptr, ptr %neg, i64 1
      
      %functionPointer = load ptr, ptr %functionPointerPointer, align 8
      %func = load ptr, ptr %functionPointer
      %obj = load ptr, ptr %object
      
      call void @free(ptr %neg)

      %stack = call %Stack @withEmptyStack()

      tail call tailcc %Pos %func(%Object %obj, %Stack %stack)
      ret void
    }
"""

extern type ThreadObject

extern def startThread { f: () => Unit }: ThreadObject = llvm """
  %thread = call %Pos @c_thread_start(%Neg ${f})
  ret %Pos %thread
"""

extern def joinThread(thread: ThreadObject): Unit = llvm """
  call void @c_thread_join(%Pos ${thread})
  ret %Pos zeroinitializer
"""

extern def sleep(seconds: Int): Unit = llvm """
  call ccc void @sleep(%Int ${seconds})
  ret %Pos zeroinitializer
"""

extern type MessageQueue[R]
extern type MessageData
extern type Continuation
extern type Actor

extern def allocateQueue[R](): MessageQueue[R] = llvm """
    %queue = call %Pos @c_queue_new()
    ret %Pos %queue
"""

extern def isEmpty[R](queue: MessageQueue[R]): Bool = llvm """
    %queue_empty = call %Pos @c_queue_empty(%Pos ${queue})
    ret %Pos %queue_empty
"""

extern def isFull[R](queue: MessageQueue[R]): Bool = llvm """
    %queue_full = call %Pos @c_queue_full(%Pos ${queue})
    ret %Pos %queue_full
"""

extern def unsafeEnqueue[R](queue: MessageQueue[R], value: R): Unit = llvm """
    %enqueue = call %Pos @c_queue_unsafeEnqueue(%Pos ${queue}, %Pos ${value})
    ret %Pos %enqueue
"""

extern def unsafeDequeue[R](queue: MessageQueue[R]): Unit = llvm """
    %enqueue = call %Pos @c_queue_unsafeDequeue(%Pos ${queue})
    ret %Pos %enqueue
"""

extern def unsafePeek[R](queue: MessageQueue[R]): R = llvm """
    %peek = call %Pos @c_queue_unsafePeek(%Pos ${queue})
    ret %Pos %peek
"""

extern def unsafePop[R](queue: MessageQueue[R]): R = llvm """
  %peek = call %Pos @c_queue_unsafePop(%Pos ${queue})
  ret %Pos %peek
"""

// Name for debugging purposes
extern def newActor(name: String): Actor = llvm """
  %actor = call %Pos @c_actor_new(%Pos ${name})
  call void @c_actor_share(%Pos %actor)
  call void @erasePositive(%Pos ${name})
  ret %Pos %actor
"""

extern def inspectActor(actor: Actor): Unit = llvm """
  call void @c_actor_inspect_queue(%Pos ${actor})
  ret %Pos zeroinitializer
"""

extern def startActor(actor: Actor) at async: Unit = llvm """
  call void @c_actor_start(%Pos ${actor}, %Stack %stack)
  ret void
"""

// TODO: Debug function, remove later
extern def inspectRC(actor: Actor): Unit = llvm """
  call void @c_inspect_rc(%Pos ${actor})
  ret %Pos zeroinitializer
"""

def actorThreadStart(actor: Actor, handlers: List[Actor]) { f: () => Unit }: ThreadObject = {
  startThread {
    // Handlers are other Actors that might receive "effects" from this actor  
    // increase RC for those Actors, so they don't terminate prematurely 
    handlers.foreach { a => shareActor(a) }
    // Starts eagerly checking messages for the actor 
    // async, will resume back to "f" while putting the message loop next on the c-stack
    startActor(actor)
    // Code the actor should run
    f()
    // Erase the actor and all handlers after the actor is done with its work
    eraseActor(actor)
    handlers.foreach { a => eraseActor(a) }
  }
}

extern def sendEmit(self: Actor, value: Int, handler: Actor) at async: Unit = llvm """
  %ret = call %Pos @c_queue_send_emit(%Pos ${self}, %Int ${value}, %Pos ${handler}, %Stack %stack)
  call void @erasePositive(%Pos ${self})
  call void @erasePositive(%Pos ${handler})
  ret void
"""

extern def sendTerminate(actor: Actor): Unit = llvm """
  %ret = call %Pos @c_queue_send_terminate(%Pos ${actor})
  call void @erasePositive(%Pos ${actor})
  ret %Pos %ret
"""

extern def eraseActor(actor: Actor): Unit = llvm """
  call void @c_actor_erase(%Pos ${actor})
  call void @erasePositive(%Pos ${actor})
  ret %Pos zeroinitializer
"""

extern def shareActor(actor: Actor): Unit = llvm """
  call void @c_actor_share(%Pos ${actor})
  call void @erasePositive(%Pos ${actor})
  ret %Pos zeroinitializer
"""

extern def test(v: Int) { f: Int => Int } at async: Int = llvm """
  %vtable = extractvalue %Neg ${f}, 0
  %closure = extractvalue %Neg ${f}, 1
  %functionPointer_pointer = getelementptr ptr, ptr %vtable, i64 0
  %functionPointer = load ptr, ptr %functionPointer_pointer

  %vPos = call %Pos @coerceIntPos(%Int ${v})
  musttail call tailcc void %functionPointer(%Object %closure, %Pos %vPos, %Stack %stack)
  ret void
"""

def main() = {
  val handler = newActor("Handler")
  val emitter = newActor("Emitter 1")
  val emitter2 = newActor("Emitter 2")

  val t1 = actorThreadStart(handler, []) {}

  val t2 = actorThreadStart(emitter, [handler]) {
    for { range(1, 10000) } { i => emitter.sendEmit(i, handler) }
  }

  val t3 = actorThreadStart(emitter2, [handler]) {
    for { range(10000, 20000) } { i => emitter.sendEmit(i, handler) }
  }

  joinThread(t1)
  joinThread(t2)
  joinThread(t3)
  
  // *********
